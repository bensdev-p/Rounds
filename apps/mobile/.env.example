# Copy to .env.local. Values come from `pnpm supabase status` (local only).
# Only the publishable key belongs in the app. Never put the secret/service key or any AI key here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Dark is the default (docs/design/DESIGN.md). Set light or system to preview
# the other theme until Settings exists. Restart `pnpm dev` after changing it.
# EXPO_PUBLIC_THEME=light
