{
  "expo": {
    "name": "PimpMe",
    "slug": "rounds",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ben.rounds",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "PimpMe connects to the computer running the app during development.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "scheme": "rounds",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-apple-authentication",
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "PimpMe listens to your answers when the attending asks.",
          "iosBackgroundMode": false,
          "androidPermissions": ["android.permission.RECORD_AUDIO"],
          "androidForegroundService": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "44e6f016-16cd-47c3-af22-7c473ba40b8e"
      }
    },
    "owner": "benfb03"
  }
}
