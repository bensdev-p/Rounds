{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "addon": "node scripts/addon.mjs",
    "build": "node scripts/addon.mjs && next build",
    "pages:deploy": "pnpm build && wrangler pages deploy out --project-name pimpme --branch main",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/archivo-narrow": "^5.3.0",
    "@rounds/shared": "workspace:*",
    "lucide-react": "~1.72.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "eslint": "^9.39.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.168.0"
  }
}
