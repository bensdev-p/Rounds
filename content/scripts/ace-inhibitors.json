    "kind": "drug",
    "name": "ACE inhibitors",
    "aliases": [
      "angiotensin-converting enzyme inhibitors"
    ],
    "systems": [
      "cardio",
      "renal"
    ],
    "rotation": [],
    "class": "Angiotensin-converting enzyme inhibitors",
    "class_members": [
      "lisinopril",
      "enalapril",
      "ramipril",
      "captopril",
      "benazepril"
    ],
    "mechanism": "Block angiotensin-converting enzyme, so less angiotensin I becomes angiotensin II. Aldosterone falls, the efferent arteriole dilates, and bradykinin builds up because ACE also breaks bradykinin down.",
    "pharmacokinetics": [
      "most are prodrugs activated in the liver; captopril and lisinopril are not",
      "cleared by the kidneys"
    ],
    "indications": [
      "hypertension",
      "heart failure with reduced ejection fraction",
      "after myocardial infarction",
      "diabetic kidney disease and chronic kidney disease with proteinuria"
    ],
    "adverse_effects": [
      "dry cough",
      "angioedema",
      "hyperkalemia",
      "acute rise in creatinine",
      "hypotension after the first dose",
      "teratogenic: fetal kidney damage"
    ],
    "contraindications": [
      "pregnancy",
      "history of angioedema",
      "bilateral renal artery stenosis",
      "within 36 hours of sacubitril-valsartan"
    ],
    "interactions": [
      "potassium-sparing diuretics and potassium supplements raise potassium further",
      "NSAIDs blunt the effect and add to kidney injury",
      "raise lithium levels"
    ],
    "monitoring": [
      "potassium and creatinine 1 to 2 weeks after starting or raising the dose"
    ],
    "overdose": {
      "features": [
        "hypotension"
      ],
      "treatment": [
        "IV fluids"
      ]
    },
    "confused_with": [],
    "pearls": [
      "A creatinine rise of up to 30% after starting is expected, and the drug can be continued.",
      "The cough comes from bradykinin; switch to an ARB, which does not raise bradykinin.",
      "ACE inhibitors slow diabetic kidney disease by dilating the efferent arteriole, which lowers pressure in the glomerulus."
    ],
