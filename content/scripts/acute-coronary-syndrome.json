{
  "script": {
    "id": "acute-coronary-syndrome",
    "status": "in_review",
    "version": 1,
    "reviewed_by": null,
    "reviewed_at": null,
    "name": "Acute coronary syndrome",
    "aliases": [
      "ACS",
      "myocardial infarction"
    ],
    "rotation": [
      "IM",
      "EM"
    ],
    "epidemiology": {
      "who": "Adults with atherosclerotic risk factors",
      "risk_factors": [
        "smoking",
        "diabetes",
        "hypertension",
        "hyperlipidemia",
        "family history of premature coronary disease",
        "older age"
      ]
    },
    "pathophysiology": "Rupture or erosion of an atherosclerotic plaque triggers a thrombus that reduces or blocks coronary blood flow, causing myocardial ischemia or infarction.",
    "timeline": {
      "onset": "Sudden, often at rest",
      "course": "Heart muscle is lost with every minute of a complete occlusion"
    },
    "key_findings": {
      "history": [
        "pressure-like chest pain radiating to the arm or jaw",
        "dyspnea",
        "diaphoresis",
        "nausea"
      ],
      "exam": [
        "often normal",
        "signs of heart failure or shock in large infarcts"
      ],
      "labs": [
        "rise and fall of high-sensitivity troponin",
        "ECG: ST elevation in STEMI; ST depression or T-wave inversion in NSTE-ACS"
      ],
      "imaging": [
        "echocardiogram for wall motion abnormalities"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "12-lead ECG within 10 minutes",
        "high-sensitivity troponin, repeated"
      ],
      "criteria": [
        "STEMI: ST elevation in two contiguous leads",
        "NSTEMI: troponin rise without ST elevation",
        "unstable angina: ischemic symptoms without a troponin rise"
      ]
    },
    "management": {
      "first_line": [
        "aspirin",
        "second antiplatelet agent (P2Y12 inhibitor such as ticagrelor)",
        "anticoagulation with heparin",
        "primary PCI within 90 minutes for STEMI"
      ],
      "next_line": [
        "fibrinolysis if PCI is not available within 120 minutes",
        "high-intensity statin",
        "beta-blocker if no heart failure or shock",
        "nitroglycerin for ongoing pain"
      ]
    },
    "complications": [
      "arrhythmias",
      "heart failure",
      "cardiogenic shock",
      "papillary muscle rupture",
      "ventricular free wall rupture"
    ],
    "confused_with": [
      {
        "script_id": "aortic-dissection",
        "how_to_tell_apart": "Aortic dissection gives sudden tearing pain radiating to the back, a blood pressure difference between arms and a widened mediastinum; exclude it before giving anticoagulants."
      },
      {
        "script_id": "pulmonary-embolism",
        "how_to_tell_apart": "PE causes pleuritic pain, hypoxemia and tachycardia, usually without ST elevation."
      }
    ],
    "pearls": [
      "Avoid nitrates in inferior MI with right ventricular involvement, or after a phosphodiesterase inhibitor such as sildenafil: they can cause severe hypotension."
    ],
    "difficulty_tiers": {
