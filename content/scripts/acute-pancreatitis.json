    "name": "Acute pancreatitis",
    "aliases": [],
    "rotation": [
      "IM",
      "surgery"
    ],
    "epidemiology": {
      "who": "Adults; gallstones are the most common cause, then heavy alcohol use",
      "risk_factors": [
        "gallstones",
        "alcohol",
        "hypertriglyceridemia",
        "post-ERCP",
        "medications",
        "hypercalcemia"
      ]
    },
    "pathophysiology": "Premature activation of pancreatic enzymes (trypsin) inside the gland causes autodigestion and local inflammation, which can become a systemic inflammatory response.",
    "timeline": {
      "onset": "Sudden, over hours",
      "course": "Mild disease settles within a week; severe disease brings organ failure lasting over 48 hours and local complications"
    },
    "key_findings": {
      "history": [
        "sudden epigastric pain radiating to the back",
        "nausea and vomiting",
        "recent heavy alcohol use or known gallstones"
      ],
      "exam": [
        "epigastric tenderness",
        "tachycardia",
        "flank or periumbilical bruising in severe disease"
      ],
      "labs": [
        "lipase more than 3 times the upper limit of normal",
        "raised ALT in gallstone pancreatitis"
      ],
      "imaging": [
        "right upper quadrant ultrasound to look for gallstones",
        "contrast CT only if the diagnosis is unclear or the patient is not improving"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "serum lipase",
        "right upper quadrant ultrasound"
      ],
      "criteria": [
        "two of three: typical epigastric pain, lipase more than 3 times the upper limit of normal, characteristic imaging findings"
      ]
    },
    "management": {
      "first_line": [
        "early goal-directed IV fluids with lactated Ringer's",
        "pain control",
        "early oral feeding as tolerated"
      ],
      "next_line": [
        "cholecystectomy during the same admission for mild gallstone pancreatitis",
        "ERCP within 24 hours if there is cholangitis",
        "no prophylactic antibiotics"
      ]
    },
    "complications": [
      "pancreatic pseudocyst",
      "walled-off necrosis",
      "infected necrosis",
      "ARDS",
      "acute kidney injury"
    ],
    "confused_with": [
      {
        "script_id": "diabetic-ketoacidosis",
        "how_to_tell_apart": "DKA can cause abdominal pain and a mildly raised lipase, but it has high glucose, ketones and an anion gap acidosis, and the pain improves as the acidosis is treated."
      }
    ],
    "pearls": [
      "Gallstone pancreatitis is suggested by an ALT more than 3 times the upper limit of normal."
    ],
