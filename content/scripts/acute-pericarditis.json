    "epidemiology": {
      "who": "Young and middle-aged adults, more often men",
      "risk_factors": [
        "recent viral infection",
        "myocardial infarction, early or weeks later (Dressler syndrome)",
        "cardiac surgery",
        "uremia",
        "lupus and other autoimmune diseases",
        "tuberculosis",
        "cancer"
      ]
    },
    "pathophysiology": "Inflammation of the pericardium, most often idiopathic or viral. The inflamed layers rub together, causing sharp pain and a friction rub, and may produce an effusion.",
    "timeline": {
      "onset": "Sudden chest pain over hours",
      "course": "Usually settles in 1 to 3 weeks; recurs in up to 30% without colchicine"
    },
    "key_findings": {
      "history": [
        "sharp pleuritic chest pain",
        "pain eased by sitting up and leaning forward",
        "pain worse lying flat",
        "recent viral illness"
      ],
      "exam": [
        "pericardial friction rub",
        "fever"
      ],
      "labs": [
        "raised CRP",
        "troponin may rise if the myocardium is involved (myopericarditis)"
      ],
      "imaging": [
        "ECG with diffuse ST elevation and PR depression",
        "echocardiogram to look for an effusion"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "ECG",
        "echocardiogram"
      ],
      "criteria": [
        "at least two of four: typical chest pain, friction rub, diffuse ST elevation or PR depression, a new or worsening pericardial effusion"
      ]
    },
    "management": {
      "first_line": [
        "NSAID such as ibuprofen, or high-dose aspirin, plus colchicine for 3 months",
        "limit strenuous exercise until symptoms and CRP settle"
      ],
      "next_line": [
        "low-dose glucocorticoids if NSAIDs fail or are contraindicated",
        "admission for high-risk features: fever above 38 C, a large effusion, tamponade or failure of NSAIDs"
      ]
    },
    "complications": [
      "recurrent pericarditis",
      "pericardial effusion",
      "cardiac tamponade",
      "constrictive pericarditis"
    ],
    "confused_with": [
      {
        "script_id": "acute-coronary-syndrome",
        "how_to_tell_apart": "Pericarditis pain is sharp, pleuritic and eased by leaning forward, with ST elevation in most leads and PR depression; a myocardial infarction causes ST elevation in one coronary territory with reciprocal depression."
      },
      {
        "script_id": "myocarditis",
        "how_to_tell_apart": "Pericarditis inflames the pericardium, causing pleuritic pain, a rub and PR depression; myocarditis inflames the heart muscle, raising troponin and weakening contraction."
      }
    ],
    "pearls": [
      "After a myocardial infarction, aspirin is preferred over other NSAIDs for pericarditis.",
      "Colchicine halves the risk of recurrence.",
      "PR depression is a characteristic ECG sign of pericarditis; reciprocal ST depression points to an MI instead."
    ],
