    "class": "Adenosine receptor agonist (unclassified antiarrhythmic)",
    "class_members": [
      "adenosine"
    ],
    "mechanism": "Activates A1 receptors in the AV node, opening potassium channels and hyperpolarizing the cells, which briefly blocks AV conduction.",
    "pharmacokinetics": [
      "half-life under 10 seconds",
      "given as a rapid IV push with a saline flush, through a large vein close to the heart"
    ],
    "indications": [
      "stopping supraventricular tachycardia that uses the AV node",
      "diagnosing atrial flutter or other atrial tachycardias by briefly slowing the ventricular rate",
      "pharmacologic stress testing"
    ],
    "adverse_effects": [
      "flushing",
      "chest discomfort",
      "dyspnea or bronchospasm",
      "a sense of impending doom",
      "brief asystole or bradycardia"
    ],
    "contraindications": [
      "asthma with active bronchospasm",
      "second- or third-degree AV block or sick sinus syndrome without a pacemaker",
      "atrial fibrillation with Wolff-Parkinson-White syndrome"
    ],
    "interactions": [
      "theophylline and caffeine block its effect, so higher doses may be needed",
      "dipyridamole and carbamazepine increase its effect, so lower doses are needed"
    ],
    "monitoring": [
      "continuous ECG during the dose"
    ],
    "overdose": {
      "features": [
        "brief asystole"
      ],
      "treatment": [
        "usually passes within seconds; aminophylline if needed"
      ]
    },
    "confused_with": [
