        "abrupt withdrawal of long-term steroids",
        "tuberculosis",
        "adrenal hemorrhage",
        "pituitary disease"
      ]
    },
    "pathophysiology": "Primary disease destroys the adrenal cortex, losing cortisol and aldosterone; secondary disease lacks ACTH, losing cortisol only.",
    "timeline": {
      "onset": "Insidious, or a sudden crisis during illness",
      "course": "Needs lifelong replacement; a crisis is fatal without steroids"
    },
    "key_findings": {
      "history": [
        "fatigue and weakness",
        "weight loss",
        "nausea, vomiting and abdominal pain",
        "salt craving"
      ],
      "exam": [
        "hypotension",
        "hyperpigmentation of skin and gums in primary disease"
      ],
      "labs": [
        "hyponatremia",
        "hyperkalemia in primary disease",
        "low morning cortisol",
        "hypoglycemia"
      ],
      "imaging": []
    },
    "diagnosis": {
      "confirmatory_tests": [
        "morning serum cortisol",
        "ACTH stimulation test (cosyntropin)",
        "plasma ACTH to separate primary from secondary disease"
      ],
      "criteria": [
        "a peak cortisol below 18 micrograms/dL after cosyntropin confirms adrenal insufficiency"
      ]
    },
    "management": {
      "first_line": [
        "adrenal crisis: IV hydrocortisone 100 mg and IV saline immediately",
        "chronic: hydrocortisone replacement",
        "fludrocortisone in primary disease"
      ],
      "next_line": [
        "double the steroid dose during illness (sick-day rules)",
        "medical alert identification and an emergency injection kit"
      ]
    },
