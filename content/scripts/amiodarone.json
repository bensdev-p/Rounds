    ],
    "rotation": [],
    "class": "Class III antiarrhythmic (potassium channel blocker) with class I, II and IV effects",
    "class_members": [
      "amiodarone",
      "dronedarone, a related drug without iodine"
    ],
    "mechanism": "Blocks potassium channels, prolonging repolarization, the action potential and the QT interval. It also blocks sodium channels, beta receptors and calcium channels.",
    "pharmacokinetics": [
      "very lipophilic, with a half-life of weeks to months",
      "contains iodine",
      "metabolized by CYP3A4 and inhibits several CYP enzymes"
    ],
    "indications": [
      "ventricular tachycardia and fibrillation, including cardiac arrest that does not respond to shocks",
      "atrial fibrillation: rhythm control, or rate control when other drugs fail, especially with heart failure"
    ],
    "adverse_effects": [
      "pulmonary fibrosis",
      "hypothyroidism or hyperthyroidism",
      "liver injury with raised transaminases",
      "corneal deposits",
      "blue-gray skin discoloration",
      "photosensitivity",
      "bradycardia and QT prolongation",
      "optic neuropathy"
    ],
    "contraindications": [
      "sinus node disease or AV block without a pacemaker",
      "cardiogenic shock"
    ],
    "interactions": [
      "raises the effect of warfarin",
      "raises digoxin levels",
      "raises statin levels and the risk of myopathy"
    ],
    "monitoring": [
      "thyroid function tests",
      "liver function tests",
      "chest X-ray and pulmonary function tests",
      "eye exams"
    ],
    "overdose": {
      "features": [
        "bradycardia",
        "hypotension",
        "QT prolongation"
      ],
      "treatment": [
        "supportive care",
        "pacing if needed"
      ]
    },
    "confused_with": [],
    "pearls": [
      "Check thyroid, liver and lung tests before starting amiodarone and during treatment.",
      "Torsades de pointes is rare with amiodarone despite its long QT.",
      "Lower the warfarin dose when starting amiodarone."
    ],
