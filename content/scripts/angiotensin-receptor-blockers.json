    "class": "Angiotensin II receptor blockers (AT1 receptor antagonists)",
    "class_members": [
      "losartan",
      "valsartan",
      "candesartan",
      "irbesartan",
      "telmisartan",
      "olmesartan"
    ],
    "mechanism": "Block the AT1 receptor, so angiotensin II cannot constrict vessels or release aldosterone. Unlike ACE inhibitors, they do not raise bradykinin.",
    "pharmacokinetics": [
      "losartan is a prodrug with an active metabolite",
      "most are dosed once daily"
    ],
    "indications": [
      "hypertension",
      "heart failure with reduced ejection fraction, when an ARNI is not feasible and ACE inhibitors are not tolerated",
      "diabetic kidney disease and chronic kidney disease with proteinuria",
      "Marfan syndrome (losartan, to slow aortic dilation)"
    ],
    "adverse_effects": [
      "hyperkalemia",
      "acute rise in creatinine",
      "hypotension",
      "teratogenic: fetal kidney damage",
      "angioedema, much rarer than with ACE inhibitors"
    ],
    "contraindications": [
      "pregnancy",
      "bilateral renal artery stenosis",
      "combined use with an ACE inhibitor"
    ],
    "interactions": [
      "potassium-sparing diuretics and potassium supplements raise potassium",
      "NSAIDs blunt the effect and add to kidney injury",
      "raise lithium levels"
    ],
    "monitoring": [
      "potassium and creatinine 1 to 2 weeks after starting"
    ],
    "overdose": {
      "features": [
        "hypotension"
      ],
      "treatment": [
        "IV fluids"
      ]
    },
    "confused_with": [
      {
        "script_id": "ace-inhibitors",
        "how_to_tell_apart": "ARBs block the angiotensin II receptor and do not raise bradykinin, so they rarely cause cough; ACE inhibitors block angiotensin II production and raise bradykinin, causing cough and more angioedema."
      }
    ],
    "pearls": [
      "Drugs ending in -sartan are ARBs; drugs ending in -pril are ACE inhibitors.",
      "Losartan lowers uric acid slightly.",
      "After angioedema on an ACE inhibitor, an ARB can usually be tried with caution."
    ],
