    "pathophysiology": "A tear in the aortic intima lets blood split the media, creating a false lumen that can extend, block branch arteries or rupture.",
    "timeline": {
      "onset": "Sudden",
      "course": "Type A (ascending aorta) is a surgical emergency with high early mortality"
    },
    "key_findings": {
      "history": [
        "sudden severe tearing chest pain radiating to the back",
        "syncope",
        "stroke-like symptoms"
      ],
      "exam": [
        "blood pressure difference of more than 20 mmHg between arms",
        "pulse deficit",
        "new murmur of aortic regurgitation"
      ],
      "labs": [
        "D-dimer usually raised"
      ],
      "imaging": [
        "widened mediastinum on chest X-ray",
        "CT angiography of the chest showing an intimal flap"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "CT angiography of the chest",
        "transesophageal echocardiogram if unstable"
      ],
      "criteria": [
        "Stanford type A involves the ascending aorta; type B does not"
      ]
    },
    "management": {
      "first_line": [
        "IV beta-blocker such as esmolol to lower heart rate and blood pressure",
        "pain control",
        "emergency surgery for type A"
      ],
      "next_line": [
        "add a vasodilator such as nicardipine after beta-blockade",
        "medical management for uncomplicated type B",
        "endovascular repair for complicated type B"
      ]
    },
    "complications": [
      "aortic rupture",
      "cardiac tamponade",
      "acute aortic regurgitation",
      "stroke",
      "mesenteric or limb ischemia"
    ],
