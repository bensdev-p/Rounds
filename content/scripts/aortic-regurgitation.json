    "kind": "disease",
    "name": "Aortic regurgitation",
    "aliases": [
      "aortic insufficiency"
    ],
    "systems": [
      "cardio"
    ],
    "rotation": [
      "IM"
    ],
    "epidemiology": {
      "who": "Adults; chronic disease from a bicuspid valve or a dilated aortic root, acute disease from endocarditis or aortic dissection",
      "risk_factors": [
        "bicuspid aortic valve",
        "aortic root dilation (Marfan syndrome, hypertension, aging)",
        "rheumatic heart disease",
        "infective endocarditis",
        "aortic dissection",
        "syphilitic aortitis",
        "ankylosing spondylitis"
      ]
    },
    "pathophysiology": "Blood leaks back from the aorta into the left ventricle in diastole. In chronic disease the ventricle dilates and hypertrophies eccentrically, stroke volume rises and the pulse pressure widens. Acute regurgitation floods a ventricle that has not adapted, causing pulmonary edema and shock.",
    "timeline": {
      "onset": "Acute (dissection, endocarditis) or chronic over years",
      "course": "Chronic disease is silent for years until the ventricle fails"
    },
    "key_findings": {
      "history": [
        "exertional dyspnea",
        "palpitations",
        "pounding heartbeat when lying down",
        "sudden pulmonary edema in acute disease"
      ],
      "exam": [
        "early diastolic decrescendo murmur at the left sternal border, louder sitting forward in expiration",
        "wide pulse pressure",
        "water-hammer (Corrigan) pulse",
        "head bobbing (de Musset sign)",
        "Austin Flint murmur",
        "other signs: Quincke pulsations in the nail beds, Duroziez murmur over the femoral artery, Traube pistol-shot sounds, Hill sign (leg pressure far above arm pressure)"
      ],
      "labs": [],
      "imaging": [
        "echocardiogram showing the regurgitant jet, its cause and the size of the left ventricle",
        "CT or MRI of the aorta when the root is dilated"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "transthoracic echocardiogram"
      ],
      "criteria": [
        "severe chronic regurgitation with symptoms, an ejection fraction of 55% or less, or a left ventricular end-systolic dimension above 50 mm is an indication for valve replacement"
      ]
    },
    "management": {
      "first_line": [
        "aortic valve replacement for severe regurgitation with symptoms, or with left ventricular dysfunction or dilation",
        "vasodilators (ACE inhibitors, ARBs, dihydropyridines) to control blood pressure"
      ],
      "next_line": [
        "urgent surgery for acute regurgitation",
        "treat the cause: dissection repair, antibiotics for endocarditis"
      ]
    },
    "complications": [
      "heart failure",
      "acute pulmonary edema in acute disease",
      "sudden death"
    ],
    "confused_with": [
      {
        "script_id": "aortic-stenosis",
        "how_to_tell_apart": "Aortic regurgitation is an early diastolic decrescendo murmur with a wide pulse pressure and bounding pulses; aortic stenosis is a systolic crescendo-decrescendo murmur with a slow-rising pulse."
      },
      {
        "script_id": "mitral-stenosis",
        "how_to_tell_apart": "Aortic regurgitation is an early diastolic decrescendo murmur at the left sternal border with a wide pulse pressure; mitral stenosis is a mid-diastolic rumble at the apex after an opening snap."
      }
    ],
    "pearls": [
      "Avoid slowing the heart with a beta blocker alone in severe aortic regurgitation; a longer diastole worsens the leak.",
      "Acute aortic regurgitation lacks the wide pulse pressure and bounding pulses, because the ventricle has not dilated.",
      "The Austin Flint murmur is a mid-diastolic rumble at the apex from the regurgitant jet hitting the mitral leaflet."
    ],
