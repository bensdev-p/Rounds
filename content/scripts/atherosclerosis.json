      ]
    },
    "pathophysiology": "Endothelial injury lets LDL into the arterial intima, where it is oxidized. Monocytes follow, become macrophages and take up the lipid to become foam cells, forming a fatty streak. Smooth muscle cells migrate in and lay down collagen, forming a fibrous cap over a lipid core. A plaque with a thin cap can rupture and trigger thrombosis.",
    "timeline": {
      "onset": "Fatty streaks begin in childhood; plaques grow silently for decades",
      "course": "Stable plaques narrow arteries and cause ischemia on exertion; ruptured plaques cause acute coronary syndrome or stroke"
    },
    "key_findings": {
      "history": [
        "often silent until a plaque narrows or ruptures",
        "exertional chest pain",
        "claudication",
        "transient neurologic symptoms"
      ],
      "exam": [
        "weak peripheral pulses",
        "arterial bruits",
        "xanthelasma"
      ],
      "labs": [
        "raised LDL cholesterol",
        "raised HbA1c in diabetes",
        "raised high-sensitivity CRP"
      ],
      "imaging": [
        "coronary artery calcium score on CT",
        "carotid ultrasound showing plaque",
        "angiography showing stenosis"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "imaging of the affected arteries: coronary CT angiography, carotid ultrasound or the ankle-brachial index"
      ],
      "criteria": [
        "the AHA PREVENT equations estimate 10-year cardiovascular risk to guide prevention"
      ]
    },
    "management": {
