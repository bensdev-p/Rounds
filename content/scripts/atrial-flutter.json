        "ECG"
      ],
      "criteria": []
    },
    "management": {
      "first_line": [
        "rate control with beta blockers or calcium channel blockers",
        "anticoagulation by the same stroke-risk rules as atrial fibrillation",
        "electrical cardioversion if unstable",
        "catheter ablation of the cavotricuspid isthmus for recurrent typical flutter, which cures it"
      ],
      "next_line": [
        "antiarrhythmic drugs if ablation is not chosen"
      ]
    },
