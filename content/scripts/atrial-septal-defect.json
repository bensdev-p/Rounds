    "epidemiology": {
      "who": "Children and adults, more often female; often first found in adulthood",
      "risk_factors": [
        "trisomy 21",
        "Holt-Oram syndrome",
        "fetal alcohol syndrome"
      ]
    },
    "pathophysiology": "A hole in the atrial septum, most often ostium secundum, lets blood shunt left to right. The right heart and lungs carry extra volume and the right ventricle enlarges. Rarely, pulmonary hypertension reverses the shunt (Eisenmenger syndrome).",
    "timeline": {
      "onset": "Often silent in childhood",
      "course": "Dyspnea and atrial arrhythmias often start in adulthood"
    },
    "key_findings": {
      "history": [
        "often no symptoms",
        "exertional dyspnea in adults",
        "palpitations from atrial fibrillation or flutter",
        "stroke from paradoxical embolism"
      ],
      "exam": [
        "wide, fixed splitting of S2",
        "systolic ejection murmur at the left upper sternal border from extra pulmonary flow"
      ],
      "labs": [],
      "imaging": [
        "echocardiogram with a bubble study showing the defect and shunt",
        "ECG with right axis deviation and incomplete right bundle branch block",
        "transesophageal echo to size the defect"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "transthoracic echocardiogram with Doppler, plus a bubble study if needed",
        "transesophageal echocardiogram"
      ],
      "criteria": []
    },
    "management": {
      "first_line": [
        "closure, by catheter device for secundum defects or by surgery, when the right heart is enlarged"
      ],
      "next_line": [
        "observation of small defects without right heart enlargement",
        "closure is contraindicated once severe pulmonary hypertension has reversed the shunt"
      ]
    },
    "complications": [
      "right heart failure",
      "atrial fibrillation",
      "paradoxical embolism",
      "Eisenmenger syndrome"
    ],
    "confused_with": [
      {
        "script_id": "ventricular-septal-defect",
        "how_to_tell_apart": "An ASD gives wide fixed splitting of S2 and a soft pulmonary flow murmur, often found in adults; a VSD gives a harsh holosystolic murmur at the left lower sternal border in infancy."
      }
    ],
    "pearls": [
      "Fixed splitting of S2 is the hallmark: the split does not change with breathing.",
      "The murmur comes from extra flow across the pulmonary valve, not from blood crossing the defect.",
      "Ostium primum defects are part of the atrioventricular canal defects seen in Down syndrome."
    ],
