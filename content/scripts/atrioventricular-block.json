    "epidemiology": {
      "who": "Older adults most often; any age with drugs, infection or congenital disease",
      "risk_factors": [
        "degenerative fibrosis of the conduction system with age",
        "inferior myocardial infarction",
        "AV nodal blocking drugs: beta blockers, calcium channel blockers, digoxin",
        "hyperkalemia",
        "Lyme carditis",
        "high vagal tone in athletes",
        "neonatal lupus from maternal anti-Ro antibodies",
        "sarcoidosis"
      ]
    },
    "pathophysiology": "Conduction from atria to ventricles is delayed or blocked in the AV node or below it, in the His-Purkinje system. Block in the AV node (first-degree, Mobitz I) is usually benign; Mobitz II and most acquired third-degree block are below the node (infranodal) and unstable, while congenital block and block after an inferior MI are often nodal with a junctional escape rhythm.",
    "timeline": {
      "onset": "Sudden or gradual",
      "course": "First-degree and Mobitz I are usually benign; Mobitz II and third-degree block can cause syncope and death"
    },
    "key_findings": {
      "history": [
        "often no symptoms",
        "fatigue",
        "dizziness",
        "syncope (Stokes-Adams attacks)"
      ],
      "exam": [
        "bradycardia",
        "cannon A waves in the neck in complete heart block",
        "varying loudness of S1 in complete heart block"
      ],
      "labs": [
        "electrolytes, especially potassium",
        "Lyme serology where relevant",
        "digoxin level if taking it"
      ],
      "imaging": [
        "ECG: first-degree, PR over 200 ms; Mobitz I, PR lengthens until a beat drops; Mobitz II, a sudden dropped beat with a constant PR; third-degree, P waves and QRS complexes independent"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "12-lead ECG",
        "ambulatory ECG monitoring for intermittent block"
      ],
      "criteria": []
    },
    "management": {
      "first_line": [
        "treat reversible causes: stop AV nodal blockers, treat Lyme disease",
        "atropine for symptomatic bradycardia",
        "a beta-agonist infusion such as dopamine, epinephrine or isoproterenol if atropine fails",
        "transcutaneous or transvenous pacing if unstable"
      ],
      "next_line": [
        "permanent pacemaker for Mobitz II, high-grade AV block, third-degree block, or symptomatic block without a reversible cause"
      ]
    },
    "complications": [
      "syncope",
      "sudden cardiac death",
      "heart failure"
    ],
    "confused_with": [],
    "pearls": [
      "Mobitz I (Wenckebach): the PR interval lengthens beat by beat until a QRS drops.",
      "Mobitz II rarely responds to atropine, because the block is below the AV node.",
      "Lyme carditis causes reversible heart block that usually resolves with antibiotics."
    ],
