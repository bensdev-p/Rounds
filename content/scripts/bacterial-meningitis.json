      ]
    },
    "pathophysiology": "Bacteria, most often Streptococcus pneumoniae or Neisseria meningitidis in adults, invade the subarachnoid space and inflame the meninges.",
    "timeline": {
      "onset": "Hours to a day",
      "course": "Fatal without prompt antibiotics; survivors may have hearing loss or neurologic deficits"
    },
    "key_findings": {
      "history": [
        "fever",
        "headache",
        "neck stiffness",
        "confusion"
      ],
      "exam": [
        "nuchal rigidity",
        "altered mental status",
        "petechial or purpuric rash in meningococcal disease",
        "Kernig and Brudzinski signs, which are insensitive"
      ],
      "labs": [
        "CSF: high neutrophils, high protein, low glucose",
        "CSF Gram stain and culture"
      ],
      "imaging": [
        "CT head before lumbar puncture only with focal deficits, papilledema, seizures, reduced consciousness or immunocompromise"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "lumbar puncture with CSF analysis",
        "blood cultures"
      ],
      "criteria": [
        "CSF neutrophilic pleocytosis with low glucose and high protein"
      ]
    },
    "management": {
      "first_line": [
        "empiric ceftriaxone plus vancomycin",
        "add ampicillin if over 50 or immunocompromised (to cover Listeria)",
        "dexamethasone before or with the first antibiotic dose"
      ],
      "next_line": [
        "droplet precautions and prophylaxis for close contacts in meningococcal disease",
        "tailor antibiotics to culture"
      ]
    },
