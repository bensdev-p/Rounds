    "kind": "drug",
    "name": "Beta blockers",
    "aliases": [
      "beta-blockers",
      "beta-adrenergic blockers"
    ],
    "systems": [
      "cardio"
    ],
    "rotation": [],
    "class": "Beta-adrenergic receptor antagonists (class II antiarrhythmics)",
    "class_members": [
      "metoprolol",
      "atenolol",
      "bisoprolol",
      "esmolol",
      "nebivolol",
      "propranolol",
      "nadolol",
      "carvedilol",
      "labetalol"
    ],
    "mechanism": "Block beta-1 receptors in the heart, lowering heart rate, contractility and renin release, and slowing conduction through the AV node. Nonselective agents also block beta-2 receptors in the airways and vessels. Carvedilol and labetalol also block alpha-1 receptors.",
    "pharmacokinetics": [
      "esmolol is very short-acting and given IV",
      "atenolol is cleared by the kidneys; metoprolol and propranolol by the liver",
      "propranolol is lipophilic and crosses into the brain"
    ],
    "indications": [
      "angina",
      "after myocardial infarction",
      "heart failure with reduced ejection fraction (carvedilol, metoprolol succinate, bisoprolol)",
      "rate control in atrial fibrillation",
      "hypertension",
      "hypertrophic cardiomyopathy",
      "thyrotoxicosis symptoms",
      "migraine prevention and essential tremor (propranolol)",
      "variceal bleeding prevention (nonselective agents)"
    ],
    "adverse_effects": [
      "bradycardia",
      "hypotension",
      "AV block",
      "bronchospasm, mostly with nonselective agents",
      "fatigue",
      "erectile dysfunction",
      "masked signs of hypoglycemia, such as tremor and palpitations",
      "worsening of acute decompensated heart failure"
    ],
    "contraindications": [
      "asthma, for nonselective agents",
      "second- or third-degree AV block or symptomatic bradycardia",
      "acute decompensated heart failure",
      "vasospastic angina"
    ],
    "interactions": [
      "verapamil or diltiazem add to bradycardia and AV block"
    ],
    "monitoring": [
      "heart rate",
      "blood pressure"
    ],
    "overdose": {
      "features": [
        "bradycardia",
        "hypotension",
        "hypoglycemia"
      ],
      "treatment": [
        "IV glucagon",
        "atropine",
        "high-dose insulin with glucose"
      ]
    },
    "confused_with": [],
    "pearls": [
      "Most beta-1 selective blockers start with A to M (atenolol, bisoprolol, esmolol, metoprolol), plus nebivolol; nonselective ones start with N to Z (nadolol, propranolol, timolol).",
      "Stopping a beta blocker suddenly can cause rebound tachycardia and angina.",
      "Glucagon reverses beta blocker overdose because it raises cAMP in heart cells without using beta receptors."
    ],
