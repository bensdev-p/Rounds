    "class": "Carbonic anhydrase inhibitors",
    "class_members": [
      "acetazolamide",
      "methazolamide",
      "dorzolamide and brinzolamide, as eye drops"
    ],
    "mechanism": "Inhibit carbonic anhydrase in the proximal tubule, so less bicarbonate is reabsorbed. Bicarbonate, sodium and water are lost in the urine, causing a mild diuresis and a hyperchloremic metabolic acidosis.",
    "pharmacokinetics": [
      "the effect fades within days as plasma bicarbonate falls",
      "dorzolamide and brinzolamide are used as eye drops"
    ],
    "indications": [
      "glaucoma",
      "acute mountain sickness prevention",
      "idiopathic intracranial hypertension",
      "metabolic alkalosis",
      "urinary alkalinization for uric acid or cystine stones"
    ],
    "adverse_effects": [
      "hyperchloremic metabolic acidosis (normal anion gap)",
      "hypokalemia",
      "paresthesias",
      "calcium phosphate kidney stones",
      "sulfonamide allergy reactions"
    ],
    "contraindications": [
      "cirrhosis, because alkaline urine raises ammonia absorption",
      "severe hypokalemia or acidosis"
    ],
    "interactions": [
      "raise the risk of salicylate toxicity"
    ],
    "monitoring": [
      "electrolytes and bicarbonate"
    ],
    "overdose": {
      "features": [
        "metabolic acidosis",
        "hypokalemia"
      ],
      "treatment": [
        "supportive care"
      ]
    },
    "confused_with": [
      {
        "script_id": "loop-diuretics",
        "how_to_tell_apart": "Acetazolamide acts on the proximal tubule and causes a metabolic acidosis; loop diuretics act on the thick ascending limb and cause a metabolic alkalosis."
      }
    ],
    "pearls": [
      "Acetazolamide causes a normal anion gap (hyperchloremic) metabolic acidosis, like a proximal renal tubular acidosis.",
      "In mountain sickness, the acidosis drives breathing and offsets the respiratory alkalosis of altitude.",
      "Alkaline urine favors calcium phosphate stones but helps dissolve uric acid and cystine stones."
    ],
