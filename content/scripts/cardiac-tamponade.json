    "epidemiology": {
      "who": "Patients with a pericardial effusion from cancer, infection, uremia, surgery or trauma",
      "risk_factors": [
        "malignancy",
        "pericarditis",
        "uremia",
        "chest trauma",
        "cardiac surgery or procedures",
        "aortic dissection into the pericardium"
      ]
    },
    "pathophysiology": "Fluid in the pericardial sac raises the pressure around the heart until the chambers cannot fill. Stroke volume and blood pressure fall. Fluid that collects quickly causes tamponade even in small volumes.",
    "timeline": {
      "onset": "Minutes (trauma, rupture) to weeks (a slowly growing effusion)",
      "course": "Fatal without drainage"
    },
    "key_findings": {
      "history": [
        "dyspnea",
        "chest pain or pressure",
        "light-headedness or syncope"
      ],
      "exam": [
        "Beck triad: hypotension, raised jugular venous pressure and muffled heart sounds",
        "pulsus paradoxus",
        "tachycardia",
        "clear lungs"
      ],
      "labs": [],
      "imaging": [
        "echocardiogram showing an effusion with right atrial collapse in late diastole and systole, or right ventricular collapse in diastole",
        "ECG with low voltage and electrical alternans",
        "chest X-ray with a large, water-bottle-shaped heart"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "bedside echocardiogram"
      ],
      "criteria": [
        "a clinical diagnosis, supported by echo signs of chamber collapse"
      ]
    },
    "management": {
      "first_line": [
        "urgent pericardiocentesis",
        "IV fluids to support filling while preparing"
      ],
      "next_line": [
        "surgical pericardial window for recurrent or loculated effusions",
        "emergency thoracotomy for traumatic tamponade with arrest"
      ]
    },
    "complications": [
      "obstructive shock",
      "cardiac arrest with pulseless electrical activity"
    ],
    "confused_with": [
      {
        "script_id": "constrictive-pericarditis",
        "how_to_tell_apart": "Tamponade is fluid under pressure with pulsus paradoxus that can develop in minutes; constrictive pericarditis is a rigid pericardium with a knock and Kussmaul sign that develops over months."
      }
    ],
    "pearls": [
      "Avoid positive-pressure ventilation and diuretics, which reduce filling further.",
      "Pulsus paradoxus is a fall in systolic pressure of more than 10 mmHg on inspiration.",
      "Electrical alternans comes from the heart swinging in the fluid."
    ],
