    ],
    "epidemiology": {
      "who": "Patients with acute myocardial infarction, most often a large anterior MI, or with decompensated heart failure",
      "risk_factors": [
        "large acute myocardial infarction",
        "mechanical complications of MI: papillary muscle rupture, ventricular septal rupture, free wall rupture",
        "acute decompensated heart failure",
        "myocarditis",
        "arrhythmias",
        "severe valve disease"
      ]
    },
    "pathophysiology": "The heart pumps too little to perfuse the organs despite adequate filling: low cardiac output, high filling pressures (a high wedge pressure) and high systemic vascular resistance as the body clamps down.",
    "timeline": {
      "onset": "Hours, often within 24 hours of an MI",
      "course": "Mortality around 40%; early revascularization improves survival"
    },
    "key_findings": {
      "history": [
        "chest pain",
        "dyspnea",
        "confusion"
      ],
      "exam": [
        "systolic pressure below 90",
        "cold, clammy, mottled skin",
        "raised JVP",
        "pulmonary crackles",
        "low urine output"
      ],
      "labs": [
        "raised lactate",
        "raised troponin",
        "raised creatinine and liver enzymes"
      ],
      "imaging": [
        "ECG for ST elevation",
        "echocardiogram for ventricular function and mechanical complications",
        "pulmonary artery catheter: low cardiac index, high wedge pressure, high systemic vascular resistance"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "clinical hypoperfusion with hypotension",
        "echocardiogram",
        "pulmonary artery catheter in selected patients"
      ],
      "criteria": [
        "systolic pressure below 90 mmHg with signs of hypoperfusion, caused by cardiac failure"
      ]
    },
    "management": {
      "first_line": [
        "emergency revascularization (PCI) of the culprit artery in MI-related shock",
        "norepinephrine for blood pressure",
        "dobutamine or milrinone for low output"
      ],
      "next_line": [
        "mechanical circulatory support such as Impella or ECMO in selected patients",
        "surgery for mechanical complications"
      ]
    },
    "complications": [
      "multiorgan failure",
      "death",
      "arrhythmias"
    ],
    "confused_with": [
      {
        "script_id": "septic-shock",
        "how_to_tell_apart": "Cardiogenic shock is cold and wet: low cardiac output, a high wedge pressure and high systemic resistance; septic shock is usually warm, with a normal or high cardiac output, low systemic resistance and a low wedge pressure."
      }
    ],
    "pearls": [
      "Cardiogenic shock is cold and wet: cold extremities and congested lungs.",
      "The SHOCK trial showed early revascularization improves survival in MI-related cardiogenic shock.",
      "Norepinephrine is the preferred first vasopressor; dopamine causes more arrhythmias."
    ],
