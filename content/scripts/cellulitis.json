    ],
    "epidemiology": {
      "who": "Adults with breaks in the skin barrier, leg edema or obesity",
      "risk_factors": [
        "skin breaks such as cuts or tinea pedis",
        "lymphedema",
        "obesity",
        "venous insufficiency",
        "prior cellulitis",
        "diabetes"
      ]
    },
    "pathophysiology": "Bacterial infection of the dermis and subcutaneous tissue, most often from beta-hemolytic streptococci and less often from Staphylococcus aureus.",
    "timeline": {
      "onset": "Over 1 to 3 days",
      "course": "Improves within 48 to 72 hours of antibiotics"
    },
    "key_findings": {
      "history": [
        "spreading redness",
        "pain",
        "fever in some"
      ],
      "exam": [
        "warm, red, tender skin with poorly defined borders",
        "usually one leg",
        "no fluctuance unless there is an abscess"
      ],
      "labs": [
        "blood cultures only if systemically unwell"
      ],
      "imaging": [
        "ultrasound if an abscess is suspected"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "clinical diagnosis"
      ],
      "criteria": [
        "acute spreading erythema, warmth and tenderness, usually on one side"
      ]
    },
    "management": {
      "first_line": [
        "oral cephalexin for nonpurulent cellulitis",
        "elevate the limb",
        "treat tinea pedis or other entry points"
      ],
      "next_line": [
        "add MRSA coverage (trimethoprim-sulfamethoxazole or doxycycline) for purulent infection",
        "IV cefazolin if systemically ill",
        "incision and drainage for an abscess"
      ]
    },
    "complications": [
      "abscess",
      "bacteremia",
      "necrotizing fasciitis",
      "recurrence"
    ],
    "confused_with": [
      {
