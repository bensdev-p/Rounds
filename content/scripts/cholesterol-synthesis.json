    "name": "Cholesterol synthesis",
    "aliases": [
      "mevalonate pathway"
    ],
    "systems": [
      "cardio",
      "general"
    ],
    "rotation": [],
    "location": "Cytosol and smooth endoplasmic reticulum, mostly in liver cells",
    "purpose": "Makes cholesterol from acetyl-CoA, for cell membranes, bile acids, steroid hormones and vitamin D.",
    "steps": [
      "acetyl-CoA to HMG-CoA by HMG-CoA synthase",
      "HMG-CoA to mevalonate by HMG-CoA reductase",
      "mevalonate to isoprene units (isopentenyl pyrophosphate)",
      "isoprene units join to make squalene",
      "squalene to lanosterol by squalene epoxidase and cyclase, then to cholesterol"
    ],
    "rate_limiting_enzyme": "HMG-CoA reductase",
    "regulation": [
      "insulin activates HMG-CoA reductase",
      "glucagon inhibits HMG-CoA reductase",
      "low cell cholesterol turns on synthesis through SREBP",
      "high cell cholesterol speeds the breakdown of HMG-CoA reductase"
    ],
    "cofactors": [
      "NADPH, from the pentose phosphate pathway"
    ],
    "deficiencies": [
      "Smith-Lemli-Opitz syndrome: 7-dehydrocholesterol reductase deficiency at the last step, with low cholesterol, high 7-dehydrocholesterol, intellectual disability and fused second and third toes"
    ],
    "drug_targets": [
      "statins inhibit HMG-CoA reductase",
      "terbinafine inhibits squalene epoxidase in the fungal version of the pathway, which makes ergosterol"
    ],
    "treatment": [
      "Smith-Lemli-Opitz syndrome: dietary cholesterol supplementation"
    ],
    "confused_with": [],
    "pearls": [
      "HMG-CoA is also made in mitochondria for ketone bodies; cholesterol synthesis uses HMG-CoA made in the cytosol.",
      "The liver makes most of its cholesterol at night, so short-acting statins are taken in the evening.",
      "Steroid hormones start when cholesterol is cleaved to pregnenolone."
    ],
