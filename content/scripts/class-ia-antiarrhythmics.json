    "class": "Class IA antiarrhythmics (sodium channel blockers that also block potassium channels)",
    "class_members": [
      "quinidine",
      "procainamide",
      "disopyramide"
    ],
    "mechanism": "Block fast sodium channels moderately, slowing phase 0 depolarization, and block potassium channels, prolonging the action potential, the refractory period and the QT interval.",
    "pharmacokinetics": [
      "procainamide is acetylated to NAPA, an active metabolite with class III effects; slow acetylators accumulate the parent drug",
      "quinidine inhibits CYP2D6"
    ],
    "indications": [
      "atrial and ventricular arrhythmias, now rarely",
      "procainamide for stable wide-complex tachycardia and for atrial fibrillation with Wolff-Parkinson-White syndrome"
    ],
    "adverse_effects": [
      "QT prolongation and torsades de pointes",
      "cinchonism with quinidine: tinnitus, headache, hearing loss",
      "drug-induced lupus with procainamide",
      "anticholinergic effects and heart failure with disopyramide",
      "diarrhea and thrombocytopenia with quinidine"
    ],
    "contraindications": [
      "long QT",
      "heart failure (disopyramide)"
    ],
    "interactions": [
      "quinidine raises digoxin levels",
      "other QT-prolonging drugs add to the risk of torsades"
    ],
    "monitoring": [
      "QT interval",
      "ANA, and procainamide levels with NAPA"
    ],
    "overdose": {
      "features": [
        "QT prolongation",
        "torsades de pointes",
        "wide QRS"
      ],
      "treatment": [
        "IV magnesium for torsades",
        "sodium bicarbonate for a wide QRS",
        "overdrive pacing"
      ]
    },
