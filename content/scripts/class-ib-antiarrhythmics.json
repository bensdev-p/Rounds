    "class": "Class IB antiarrhythmics (weak sodium channel blockers)",
    "class_members": [
      "lidocaine",
      "mexiletine",
      "phenytoin"
    ],
    "mechanism": "Block sodium channels with fast on-off kinetics, preferring depolarized (ischemic) tissue, and shorten the action potential. They act mainly on the ventricles and barely change the QT interval.",
    "pharmacokinetics": [
      "lidocaine has high first-pass metabolism, so it is given IV",
      "mexiletine is the oral analogue"
    ],
    "indications": [
      "ventricular arrhythmias, especially with ischemia or after myocardial infarction",
      "ventricular fibrillation or pulseless VT that persists after shocks (lidocaine, as an alternative to amiodarone)",
      "ventricular arrhythmias from digoxin toxicity"
    ],
    "adverse_effects": [
      "neurologic toxicity: perioral numbness, tremor, confusion and seizures",
      "bradycardia and hypotension at high levels"
    ],
    "contraindications": [
      "severe heart block without a pacemaker"
    ],
    "interactions": [
      "beta blockers and cimetidine slow lidocaine clearance"
    ],
    "monitoring": [
      "neurologic symptoms",
      "lidocaine levels during long infusions"
    ],
    "overdose": {
      "features": [
        "seizures",
        "perioral numbness",
        "bradycardia"
      ],
      "treatment": [
        "benzodiazepines for seizures",
        "IV lipid emulsion for severe toxicity"
      ]
    },
    "confused_with": [
      {
        "script_id": "class-ia-antiarrhythmics",
        "how_to_tell_apart": "Class IB drugs block sodium weakly, shorten the action potential and act mainly on ischemic ventricles; class IA drugs block sodium and potassium channels and prolong the QT interval."
      },
      {
        "script_id": "class-ic-antiarrhythmics",
        "how_to_tell_apart": "Class IB drugs block sodium weakly and target ischemic ventricular tissue; class IC drugs block sodium strongly, widen the QRS and raise mortality after a myocardial infarction."
      }
    ],
    "pearls": [
      "Class IB drugs target ischemic, depolarized ventricular tissue; unlike class IC, they are not linked to excess mortality after MI, though lidocaine is not given routinely to prevent arrhythmias.",
      "Lidocaine toxicity often starts with perioral numbness and ends in seizures.",
      "Phenytoin, an antiseizure drug, is also a class IB antiarrhythmic."
    ],
