        "raised creatinine in severe disease"
      ],
      "imaging": [
        "CT for suspected fulminant colitis or toxic megacolon"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "stool test for C. difficile toxin or toxin gene (PCR)"
      ],
      "criteria": [
        "test only unformed stool, from patients with 3 or more unexplained loose stools in 24 hours",
        "severe: white count of 15,000 or more, or creatinine above 1.5 mg/dL"
      ]
    },
    "management": {
      "first_line": [
        "oral fidaxomicin or oral vancomycin",
        "stop the inciting antibiotic if possible",
        "contact precautions and soap-and-water hand hygiene"
      ],
      "next_line": [
        "fulminant disease: oral vancomycin plus IV metronidazole, and a surgical consult",
        "recurrence: fidaxomicin, bezlotoxumab or fecal microbiota transplant"
      ]
    },
