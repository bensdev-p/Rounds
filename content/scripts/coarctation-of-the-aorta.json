    "epidemiology": {
      "who": "Infants and children, more often boys, and girls with Turner syndrome",
      "risk_factors": [
        "Turner syndrome",
        "bicuspid aortic valve",
        "male sex"
      ]
    },
    "pathophysiology": "A narrowing of the aorta, usually just beyond the left subclavian artery near the ductus. Pressure is high above the narrowing and low below it; collateral arteries, including the intercostals, enlarge to bypass it.",
    "timeline": {
      "onset": "Severe coarctation presents in newborns when the duct closes; milder disease presents later with hypertension",
      "course": "Untreated, it leads to heart failure, aortic dissection and stroke"
    },
    "key_findings": {
      "history": [
        "headaches and nosebleeds",
        "leg claudication",
        "shock in a newborn when the duct closes"
      ],
      "exam": [
        "high blood pressure in the arms with low pressure in the legs",
        "weak or delayed femoral pulses (brachiofemoral delay)",
        "systolic murmur heard over the back"
      ],
      "labs": [],
      "imaging": [
        "chest X-ray with rib notching from enlarged intercostal arteries and a figure-3 sign",
        "echocardiogram",
        "CT or MRI angiography"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "echocardiogram",
        "CT or MRI angiography"
      ],
      "criteria": []
    },
    "management": {
      "first_line": [
        "prostaglandin E1 for a newborn with duct-dependent coarctation",
        "surgical repair, or balloon angioplasty with stenting"
      ],
      "next_line": [
        "lifelong follow-up for re-narrowing, hypertension and aneurysm"
      ]
    },
    "complications": [
      "hypertension",
      "heart failure",
      "aortic dissection",
      "intracranial berry aneurysm rupture",
      "infective endarteritis"
    ],
    "confused_with": [
      {
        "script_id": "essential-hypertension",
        "how_to_tell_apart": "Coarctation is a secondary cause of hypertension, with high arm pressure, low leg pressure and weak, delayed femoral pulses; in essential hypertension arm and leg pressures match and the pulses are normal."
      }
    ],
    "pearls": [
      "Always feel the femoral pulses in a young person with hypertension.",
      "Rib notching takes years to appear, so it is a sign in older children and adults, not newborns.",
      "Coarctation is linked with bicuspid aortic valve and Turner syndrome."
    ],
