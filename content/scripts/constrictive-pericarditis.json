{
  "script": {
    "id": "constrictive-pericarditis",
    "status": "in_review",
    "version": 1,
    "reviewed_by": null,
    "reviewed_at": null,
    "kind": "disease",
    "name": "Constrictive pericarditis",
    "aliases": [
      "pericardial constriction"
    ],
    "systems": [
      "cardio"
    ],
    "rotation": [
      "IM"
    ],
    "epidemiology": {
      "who": "Adults after pericarditis, cardiac surgery, radiation or tuberculosis",
      "risk_factors": [
        "prior viral or idiopathic pericarditis",
        "cardiac surgery",
        "chest radiation",
        "tuberculosis, the leading cause in low-income countries",
        "connective tissue disease"
      ]
    },
    "pathophysiology": "The pericardium thickens, scars and sometimes calcifies into a rigid shell. Early diastolic filling is rapid and then stops abruptly, so venous pressures rise and the two ventricles compete for space (interventricular dependence).",
    "timeline": {
      "onset": "Months to years after the injury",
      "course": "Progressive right-sided heart failure; cured by pericardiectomy"
    },
    "key_findings": {
      "history": [
        "fatigue",
        "leg swelling",
        "abdominal swelling",
        "exertional dyspnea"
      ],
      "exam": [
        "raised JVP that rises on inspiration (Kussmaul sign)",
        "pericardial knock in early diastole",
        "ascites and edema out of proportion to lung findings",
        "hepatomegaly"
      ],
      "labs": [
        "BNP lower than expected for the degree of congestion"
      ],
      "imaging": [
        "CT or MRI showing a thickened pericardium",
        "chest X-ray showing pericardial calcification",
        "echocardiogram with septal bounce and respiratory variation in filling"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "cardiac CT or MRI",
        "echocardiogram",
        "cardiac catheterization showing equalized diastolic pressures and interventricular dependence"
      ],
      "criteria": []
    },
    "management": {
      "first_line": [
        "diuretics for symptoms",
        "anti-inflammatory therapy if the constriction is new and still inflamed (transient constriction)"
      ],
      "next_line": [
        "surgical pericardiectomy for chronic constriction"
      ]
    },
    "complications": [
      "right heart failure",
      "cardiac cirrhosis",
      "protein-losing enteropathy"
    ],
    "confused_with": [
      {
        "script_id": "restrictive-cardiomyopathy",
        "how_to_tell_apart": "Both fill poorly and raise venous pressure, but constrictive pericarditis has a thick, often calcified pericardium, a pericardial knock and a lower BNP; restrictive cardiomyopathy has stiff heart muscle, a high BNP and a normal pericardium.",
        "compare": [
          {
            "label": "Problem",
            "text": "Rigid pericardium",
            "source_field": "pathophysiology"
          },
          {
            "label": "BNP",
            "text": "Lower than expected",
            "source_field": "key_findings.labs[0]"
          }
        ]
      },
      {
        "script_id": "cardiac-tamponade",
        "how_to_tell_apart": "Both limit filling, but constrictive pericarditis is a rigid pericardium with a knock and Kussmaul sign that develops over months; tamponade is fluid under pressure with pulsus paradoxus that can develop in minutes."
      }
    ],
    "pearls": [
      "Kussmaul sign is typical of constrictive pericarditis and usually absent in tamponade, where pulsus paradoxus dominates.",
      "A pericardial knock is an early diastolic sound made as filling stops abruptly.",
      "Tuberculosis is the most common cause worldwide."
    ],
