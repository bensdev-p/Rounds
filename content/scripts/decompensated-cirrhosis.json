        "alcohol-related liver disease",
        "chronic hepatitis C",
        "chronic hepatitis B",
        "metabolic dysfunction-associated steatotic liver disease"
      ]
    },
    "pathophysiology": "Chronic liver injury causes fibrosis and portal hypertension, leading to ascites, varices and loss of the liver's synthetic and detoxifying function.",
    "timeline": {
      "onset": "Develops over years; decompensation can be sudden",
      "course": "Decompensation marks a sharp fall in survival; transplant is the cure"
    },
    "key_findings": {
      "history": [
        "abdominal swelling",
        "jaundice",
        "confusion",
        "vomiting blood or black stools"
      ],
      "exam": [
        "ascites",
        "jaundice",
        "spider angiomas",
        "palmar erythema",
        "asterixis"
      ],
      "labs": [
        "low albumin",
        "prolonged INR",
        "raised bilirubin",
        "low platelets"
      ],
      "imaging": [
        "ultrasound: nodular liver, splenomegaly, ascites"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "diagnostic paracentesis for new ascites or any admission with ascites",
        "serum-ascites albumin gradient"
      ],
      "criteria": [
        "decompensation means ascites, variceal bleeding, hepatic encephalopathy or jaundice",
        "a serum-ascites albumin gradient of 1.1 g/dL or more means portal hypertension"
      ]
    },
    "management": {
      "first_line": [
        "sodium restriction and diuretics (spironolactone with furosemide) for ascites",
        "lactulose for hepatic encephalopathy",
        "nonselective beta-blocker such as carvedilol to prevent variceal bleeding"
      ],
      "next_line": [
        "large-volume paracentesis with albumin for tense ascites",
        "add rifaximin to lactulose",
        "refer for liver transplant evaluation"
      ]
    },
    "complications": [
      "spontaneous bacterial peritonitis",
      "hepatorenal syndrome",
      "variceal bleeding",
      "hepatic encephalopathy",
      "hepatocellular carcinoma"
    ],
