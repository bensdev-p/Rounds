        "tenderness along the deep veins"
      ],
      "labs": [
        "raised D-dimer, useful to rule out DVT when pretest probability is low"
      ],
      "imaging": [
        "compression ultrasound showing a noncompressible vein"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "compression ultrasound",
