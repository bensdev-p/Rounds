      ],
      "criteria": [
        "the Wells score estimates pretest probability"
      ]
    },
    "management": {
      "first_line": [
        "anticoagulation with a direct oral anticoagulant such as apixaban or rivaroxaban for at least 3 months"
      ],
      "next_line": [
        "low-molecular-weight heparin in pregnancy",
        "IVC filter only if anticoagulation is contraindicated"
      ]
    },
