{
  "script": {
    "id": "diabetic-ketoacidosis",
    "status": "draft",
    "version": 1,
    "reviewed_by": null,
    "reviewed_at": null,
    "name": "Diabetic ketoacidosis",
    "aliases": [
      "DKA"
    ],
    "rotation": [
      "IM",
      "EM"
    ],
    "epidemiology": {
      "who": "Mostly people with type 1 diabetes, often as the first presentation; also type 2 diabetes under acute stress or on SGLT2 inhibitors",
      "risk_factors": [
        "infection",
        "insulin omission",
        "new-onset diabetes",
        "SGLT2 inhibitors",
        "myocardial infarction",
        "pancreatitis"
      ]
    },
    "pathophysiology": "Insulin deficiency plus excess counterregulatory hormones (glucagon, cortisol, catecholamines) drive lipolysis and hepatic ketogenesis, causing an anion gap metabolic acidosis. Hyperglycemia causes an osmotic diuresis with volume depletion and a total-body potassium deficit.",
    "timeline": {
      "onset": "Develops over hours, usually less than 24 hours",
      "course": "Resolves over about a day with fluids, insulin and potassium; can recur if the precipitant is not treated"
    },
    "key_findings": {
      "history": [
        "polyuria and polydipsia",
        "nausea and vomiting",
        "abdominal pain"
      ],
      "exam": [
        "Kussmaul respirations (deep, rapid breathing)",
        "fruity (acetone) breath",
        "signs of volume depletion: tachycardia, dry mucous membranes"
      ],
      "labs": [
        "glucose usually above 250 mg/dL",
        "anion gap metabolic acidosis",
        "raised serum beta-hydroxybutyrate",
        "serum potassium often normal or high despite a total-body deficit"
      ],
      "imaging": []
    },
    "diagnosis": {
      "confirmatory_tests": [
        "serum beta-hydroxybutyrate",
        "venous blood gas",
        "basic metabolic panel with anion gap"
      ],
      "criteria": [
        "glucose of 200 mg/dL or more, or known diabetes",
        "ketosis: beta-hydroxybutyrate of 3.0 mmol/L or more, or urine ketones 2+ or more",
        "acidosis: pH below 7.3 and/or bicarbonate below 18 mEq/L"
      ]
    },
    "management": {
      "first_line": [
        "IV isotonic fluids",
        "IV insulin infusion",
        "potassium replacement"
      ],
      "next_line": [
        "add dextrose to the fluids when glucose falls below 250 mg/dL",
        "bicarbonate only if pH is below 7.0",
        "overlap subcutaneous basal insulin by 1 to 2 hours before stopping the infusion",
        "treat the precipitant"
      ]
    },
    "complications": [
      "hypokalemia",
      "hypoglycemia",
      "cerebral edema, mainly in children",
      "recurrence after stopping the infusion too early"
    ],
    "confused_with": [
      {
        "script_id": "acute-pancreatitis",
        "how_to_tell_apart": "DKA causes abdominal pain and can raise lipase, but the labs show an anion gap acidosis with high ketones, and the pain eases as the acidosis is corrected; in pancreatitis the pain persists and imaging shows an inflamed pancreas."
      }
    ],
    "pearls": [
      "Check potassium before starting insulin: if it is below 3.5 mEq/L, replace it first and hold insulin, because insulin drives potassium into cells."
    ],
    "difficulty_tiers": {
      "MS1-2": [
