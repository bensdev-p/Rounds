      "amlodipine has a long half-life and is taken once daily",
      "nicardipine and clevidipine are given IV and titrated quickly"
    ],
    "indications": [
      "hypertension",
      "stable angina",
      "vasospastic angina",
      "Raynaud phenomenon",
      "hypertensive emergency (IV nicardipine or clevidipine)",
      "subarachnoid hemorrhage, to reduce injury from vasospasm (nimodipine)"
    ],
    "adverse_effects": [
      "peripheral edema",
      "headache",
      "flushing",
      "reflex tachycardia",
      "gingival hyperplasia"
    ],
    "contraindications": [
      "short-acting nifedipine in acute coronary syndrome",
      "heart failure with reduced ejection fraction, except amlodipine and felodipine, which are neutral"
    ],
    "interactions": [
      "CYP3A4 inhibitors raise levels",
      "combined with beta blockers, which offset the reflex tachycardia"
    ],
    "monitoring": [
      "blood pressure",
      "ankle swelling"
    ],
