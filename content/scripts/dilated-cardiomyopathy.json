    ],
    "confused_with": [
      {
        "script_id": "hypertrophic-cardiomyopathy",
        "how_to_tell_apart": "Dilated cardiomyopathy has a big, thin-walled ventricle that pumps weakly, with a low ejection fraction; hypertrophic cardiomyopathy has a thick, stiff ventricle that pumps normally or too well."
      }
    ],
    "pearls": [
      "Dilated cardiomyopathy shows eccentric hypertrophy; hypertrophic cardiomyopathy shows concentric, often asymmetric, hypertrophy.",
      "Peripartum cardiomyopathy appears in the last month of pregnancy or up to 5 months after delivery.",
