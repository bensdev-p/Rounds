    "epidemiology": {
      "who": "Adults with late-onset asthma, often aged 30 to 50",
      "risk_factors": [
        "asthma",
        "allergic rhinitis",
        "nasal polyps"
      ]
    },
    "pathophysiology": "A necrotizing small-vessel vasculitis with eosinophil-rich granulomas in people with asthma and eosinophilia. About 40% have MPO-ANCA (p-ANCA).",
    "timeline": {
      "onset": "Phases over years: allergic (asthma, rhinitis), then eosinophilic (eosinophilia, lung infiltrates), then vasculitic",
      "course": "Relapsing; asthma often persists"
    },
    "key_findings": {
      "history": [
        "adult-onset asthma",
        "chronic sinusitis and nasal polyps",
        "numbness or weakness from mononeuritis multiplex",
        "chest pain or heart failure from cardiac involvement"
      ],
      "exam": [
        "palpable purpura",
        "foot or wrist drop",
        "nasal polyps"
      ],
      "labs": [
        "eosinophilia, often over 10% of white cells",
        "raised IgE",
        "MPO-ANCA (p-ANCA) in about 40%"
      ],
      "imaging": [
        "chest imaging with migratory pulmonary infiltrates",
        "echocardiogram or cardiac MRI for heart involvement"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "blood eosinophil count",
        "biopsy showing eosinophilic granulomatous vasculitis"
      ],
      "criteria": []
    },
    "management": {
      "first_line": [
        "glucocorticoids",
        "mepolizumab or benralizumab (anti-IL-5 pathway) for non-severe or relapsing disease"
      ],
      "next_line": [
        "cyclophosphamide or rituximab for severe, organ-threatening disease"
      ]
    },
    "complications": [
      "eosinophilic myocarditis and heart failure, the main cause of death",
      "mononeuritis multiplex",
      "glomerulonephritis"
    ],
    "confused_with": [
      {
        "script_id": "granulomatosis-with-polyangiitis",
        "how_to_tell_apart": "EGPA comes with asthma and marked eosinophilia and is p-ANCA positive in some; granulomatosis with polyangiitis has destructive sinus and nose disease without asthma or eosinophilia and is usually c-ANCA."
      }
    ],
    "pearls": [
      "Heart involvement is the most common cause of death in EGPA.",
      "Asthma plus eosinophilia plus vasculitis: think EGPA.",
      "Leukotriene receptor antagonists such as montelukast may unmask EGPA as steroids are tapered."
    ],
