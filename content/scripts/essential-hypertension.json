    "epidemiology": {
      "who": "Adults, more often with age; about 90% of hypertension has no single identifiable cause",
      "risk_factors": [
        "older age",
        "family history",
        "obesity",
        "high sodium intake",
        "physical inactivity",
        "excess alcohol",
        "Black ancestry"
      ]
    },
    "pathophysiology": "Blood pressure rises from a mix of genetic and environmental factors: more sympathetic tone, renin-angiotensin-aldosterone activity, sodium retention and stiffer arteries. Over years it damages the heart, kidneys, brain and eyes.",
    "timeline": {
      "onset": "Silent; usually found on screening",
      "course": "Lifelong; untreated, it raises the risk of stroke, heart attack, heart failure and kidney disease"
    },
    "key_findings": {
      "history": [
        "usually no symptoms",
        "headache only when blood pressure is very high"
      ],
      "exam": [
        "blood pressure of 130/80 mmHg or higher on repeated readings",
        "hypertensive retinopathy: arteriovenous nicking and cotton wool spots",
        "left ventricular heave in long-standing disease"
      ],
      "labs": [
        "basic metabolic panel with creatinine and potassium",
        "urinalysis and urine albumin",
        "fasting glucose or HbA1c and a lipid panel"
      ],
      "imaging": [
        "ECG to look for left ventricular hypertrophy"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "repeated office readings confirmed with ambulatory or home blood pressure monitoring"
      ],
      "criteria": [
        "AHA/ACC 2025: stage 1 hypertension is 130 to 139 systolic or 80 to 89 diastolic",
        "AHA/ACC 2025: stage 2 hypertension is 140 systolic or 90 diastolic and above"
      ]
    },
    "management": {
      "first_line": [
        "lifestyle: weight loss, DASH diet, less salt, exercise and less alcohol",
        "first-line drug classes: thiazide diuretic, ACE inhibitor, ARB or dihydropyridine calcium channel blocker",
        "ACE inhibitor or ARB when there is diabetes with albuminuria or chronic kidney disease",
        "a target under 130/80 for most adults"
      ],
      "next_line": [
        "stage 2: start two first-line classes, ideally as a single-pill combination",
        "add spironolactone for resistant hypertension",
        "look for a secondary cause when hypertension is resistant or starts young"
      ]
    },
    "complications": [
      "stroke",
      "coronary artery disease",
      "heart failure",
      "chronic kidney disease",
      "aortic dissection",
      "hypertensive retinopathy"
    ],
    "confused_with": [
      {
        "script_id": "hypertensive-emergency",
        "how_to_tell_apart": "Essential hypertension is chronic, silent and treated with oral drugs; a hypertensive emergency is severe hypertension with acute organ damage, needing IV drugs in the ICU."
      },
      {
        "script_id": "coarctation-of-the-aorta",
        "how_to_tell_apart": "In essential hypertension arm and leg pressures match and the pulses are normal; coarctation causes high arm pressure, low leg pressure and weak, delayed femoral pulses."
      }
    ],
    "pearls": [
      "Never combine an ACE inhibitor with an ARB.",
      "Resistant hypertension is blood pressure above goal despite three drugs, one of them a diuretic.",
      "Hypertension in a young person, or with a low potassium, should prompt a search for a secondary cause such as primary hyperaldosteronism."
    ],
