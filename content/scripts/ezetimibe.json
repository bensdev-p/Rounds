    "class_members": [
      "ezetimibe"
    ],
    "mechanism": "Blocks the NPC1L1 transporter on the brush border of the small intestine, reducing absorption of dietary and biliary cholesterol. LDL falls by about 20%.",
    "pharmacokinetics": [
      "glucuronidated in the gut and liver, with enterohepatic recycling",
      "taken once daily"
    ],
    "indications": [
      "primary hyperlipidemia (high LDL)",
      "added to a statin when LDL stays above goal",
      "in place of a statin when statins are not tolerated",
      "sitosterolemia"
    ],
    "adverse_effects": [
      "diarrhea",
      "raised liver enzymes when combined with a statin",
      "muscle aches, uncommon"
    ],
    "contraindications": [
      "active liver disease when combined with a statin"
    ],
    "interactions": [
      "bile acid sequestrants reduce absorption, so give ezetimibe 2 hours before or 4 hours after",
      "cyclosporine raises levels"
    ],
