    "epidemiology": {
      "who": "About 1 in 250 people have heterozygous FH; homozygous FH is very rare",
      "risk_factors": [
        "family history of very high LDL or early heart disease",
        "an LDL receptor variant, the most common cause",
        "APOB or gain-of-function PCSK9 variants"
      ]
    },
    "pathophysiology": "Autosomal dominant defects in LDL clearance (LDLR, APOB or gain-of-function PCSK9) raise LDL from birth and cause early atherosclerosis. Homozygotes have extreme LDL levels and can have heart attacks in childhood.",
    "timeline": {
      "onset": "High LDL from birth",
      "course": "Untreated heterozygous men often have coronary disease by their 50s"
    },
    "key_findings": {
      "history": [
        "premature coronary disease in the patient or relatives",
        "family history of high cholesterol"
      ],
      "exam": [
        "tendon xanthomas, especially of the Achilles tendons and the extensor tendons of the hands",
        "xanthelasma",
        "corneal arcus before age 45"
      ],
      "labs": [
        "LDL above 190 mg/dL in adults, or above 160 in children",
        "normal triglycerides"
      ],
      "imaging": []
    },
    "diagnosis": {
      "confirmatory_tests": [
        "lipid panel",
        "genetic testing"
      ],
      "criteria": [
        "the Dutch Lipid Clinic Network or Simon Broome criteria combine LDL, family history, signs and genetics"
      ]
    },
    "management": {
      "first_line": [
        "high-intensity statin",
        "add ezetimibe, then a PCSK9 inhibitor, to reach LDL goals",
        "cascade screening of first-degree relatives",
        "statins started in childhood, around age 8 to 10"
      ],
      "next_line": [
        "LDL apheresis, evinacumab or lomitapide for homozygous FH",
        "lifestyle measures alongside drugs"
      ]
    },
    "complications": [
      "premature coronary artery disease",
      "aortic stenosis in homozygous FH"
    ],
    "confused_with": [],
    "pearls": [
      "Tendon xanthomas are nearly diagnostic of FH.",
      "Cascade screening: test the first-degree relatives of everyone with FH.",
      "Corneal arcus before age 45 suggests FH."
    ],
