        "northern European ancestry"
      ]
    },
    "pathophysiology": "Granulomatous inflammation of large and medium arteries, especially branches of the external carotid artery. The wall thickens, with giant cells, and the lumen narrows, causing ischemia.",
    "timeline": {
      "onset": "Weeks of headache and systemic symptoms",
      "course": "Treatment lasts 1 to 2 years; vision loss can be sudden and permanent"
    },
    "key_findings": {
      "history": [
        "new headache, often temporal",
        "jaw claudication",
        "scalp tenderness",
        "visual loss or diplopia",
        "shoulder and hip girdle stiffness from polymyalgia rheumatica",
        "fever, weight loss and fatigue"
      ],
      "exam": [
        "tender, thickened or pulseless temporal artery",
        "reduced vision"
      ],
      "labs": [
        "raised ESR",
        "raised CRP",
        "normocytic anemia",
        "raised platelet count"
      ],
      "imaging": [
        "temporal artery ultrasound showing a halo sign",
        "PET or CT angiography for large-vessel involvement"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "temporal artery biopsy",
        "temporal artery ultrasound"
      ],
      "criteria": []
    },
    "management": {
      "first_line": [
        "high-dose glucocorticoids started right away, without waiting for the biopsy",
        "IV methylprednisolone if vision is affected"
      ],
      "next_line": [
        "tocilizumab to spare glucocorticoids",
        "methotrexate as an alternative steroid-sparing drug"
      ]
    },
    "complications": [
      "permanent vision loss from anterior ischemic optic neuropathy",
      "stroke",
      "thoracic aortic aneurysm",
      "glucocorticoid side effects"
    ],
    "confused_with": [
      {
        "script_id": "takayasu-arteritis",
        "how_to_tell_apart": "Giant cell arteritis affects people over 50 and favors the temporal and other cranial arteries; Takayasu arteritis affects women under 40 and narrows the aorta and its branches, causing weak arm pulses."
      }
    ],
    "pearls": [
      "Start steroids before the biopsy; the biopsy stays positive for at least 1 to 2 weeks.",
      "A biopsy can be falsely negative because the inflammation leaves gaps (skip lesions).",
      "About half of patients with giant cell arteritis also have polymyalgia rheumatica."
    ],
