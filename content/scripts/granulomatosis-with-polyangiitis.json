      "IM"
    ],
    "epidemiology": {
      "who": "Adults, usually aged 40 to 65",
      "risk_factors": [
        "age 40 to 65",
        "white ancestry",
        "nasal carriage of Staphylococcus aureus, linked to relapse"
      ]
    },
    "pathophysiology": "A small-vessel vasculitis with necrotizing granulomas, linked to ANCA against proteinase 3 (PR3-ANCA, c-ANCA). It classically affects the upper airway, the lungs and the kidneys.",
    "timeline": {
      "onset": "Weeks to months of sinus and systemic symptoms",
      "course": "Fatal untreated; treatment brings remission, but relapses are common"
    },
    "key_findings": {
      "history": [
        "chronic sinusitis or nosebleeds",
        "hemoptysis",
        "hematuria",
        "fever, weight loss and joint pain"
      ],
      "exam": [
        "saddle nose deformity",
        "nasal crusting or ulcers",
        "palpable purpura"
      ],
      "labs": [
        "positive PR3-ANCA (c-ANCA)",
        "hematuria with red cell casts",
        "rising creatinine",
        "raised ESR or CRP"
      ],
      "imaging": [
        "chest CT with lung nodules, often cavitating"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "PR3-ANCA (c-ANCA)",
        "biopsy of an affected organ showing necrotizing granulomatous vasculitis"
      ],
      "criteria": []
    },
    "management": {
      "first_line": [
        "induction with high-dose glucocorticoids plus rituximab or cyclophosphamide"
      ],
      "next_line": [
        "maintenance with rituximab or azathioprine",
        "plasma exchange only in selected cases, such as severe kidney disease",
        "trimethoprim-sulfamethoxazole to prevent Pneumocystis pneumonia during treatment"
      ]
    },
    "complications": [
      "rapidly progressive glomerulonephritis",
      "pulmonary hemorrhage",
      "saddle nose deformity",
      "subglottic stenosis"
    ],
    "confused_with": [
      {
        "script_id": "microscopic-polyangiitis",
        "how_to_tell_apart": "Granulomatosis with polyangiitis involves the sinuses and nose, has granulomas and is usually PR3-ANCA; microscopic polyangiitis has no granulomas or upper airway disease and is usually MPO-ANCA."
      },
      {
        "script_id": "eosinophilic-granulomatosis-with-polyangiitis",
        "how_to_tell_apart": "Granulomatosis with polyangiitis has destructive sinus and nose disease without asthma or eosinophilia and is usually c-ANCA; EGPA comes with asthma and marked eosinophilia and is p-ANCA positive in some."
      }
    ],
    "pearls": [
      "Upper airway disease separates granulomatosis with polyangiitis from microscopic polyangiitis, which has no granulomas and is usually MPO-ANCA (p-ANCA).",
      "c-ANCA is aimed at proteinase 3.",
      "The classic triad is upper airway, lung and kidney involvement."
    ],
