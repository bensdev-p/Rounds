    "epidemiology": {
      "who": "Adults with known chronic heart failure, with reduced or preserved ejection fraction",
      "risk_factors": [
        "high salt intake",
        "medication nonadherence",
        "myocardial ischemia",
        "atrial fibrillation",
        "uncontrolled hypertension",
        "infection",
        "NSAIDs"
      ]
    },
    "pathophysiology": "Worsening cardiac function or a precipitant raises left-sided filling pressures, causing pulmonary congestion, while sodium and water retention cause systemic venous congestion.",
    "timeline": {
      "onset": "Usually over days, sometimes hours",
      "course": "Most improve with diuresis over several days; each admission marks a worse long-term prognosis"
    },
    "key_findings": {
      "history": ["worsening dyspnea", "orthopnea", "paroxysmal nocturnal dyspnea", "weight gain", "leg swelling"],
      "exam": ["raised JVP", "bibasilar crackles", "S3 gallop", "pitting edema"],
      "labs": ["raised BNP or NT-proBNP", "troponin may be mildly raised"],
      "imaging": [
        "chest X-ray: pulmonary vascular congestion, interstitial edema, Kerley B lines, pleural effusions",
        "echocardiogram to assess ejection fraction"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": ["BNP or NT-proBNP", "echocardiogram", "chest X-ray"],
      "criteria": ["clinical diagnosis: symptoms and signs of congestion, supported by a raised natriuretic peptide"]
    },
    "management": {
      "first_line": ["IV loop diuretics such as furosemide", "supplemental oxygen if hypoxemic", "treat the precipitant"],
      "next_line": [
        "add a thiazide-type diuretic such as metolazone if diuresis is inadequate",
        "noninvasive ventilation for respiratory distress",
        "vasodilators such as nitroglycerin if hypertensive",
        "inotropes for low output with hypoperfusion"
      ]
    },
    "complications": ["cardiogenic shock", "acute kidney injury", "arrhythmias", "hypokalemia from diuresis"],
    "confused_with": [
      {
        "script_id": "community-acquired-pneumonia",
        "how_to_tell_apart": "Pneumonia usually brings fever, productive cough and a focal consolidation; heart failure gives bilateral crackles, a raised JVP, leg edema and a high BNP."
      }
    ],
    "pearls": ["The first IV loop diuretic dose should equal or exceed the patient's total daily oral dose."],
