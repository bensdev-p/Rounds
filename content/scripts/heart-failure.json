    "pathophysiology": "The heart cannot pump enough blood at normal filling pressures. In heart failure with reduced ejection fraction (HFrEF) the ventricle dilates and contracts poorly; in heart failure with preserved ejection fraction (HFpEF) it is stiff and fills poorly. Activation of the renin-angiotensin-aldosterone system and the sympathetic nervous system drives sodium retention and remodeling.",
    "timeline": {
      "onset": "Gradual, over months to years",
      "course": "Progressive, with acute decompensations; guideline-directed therapy lowers mortality in HFrEF"
    },
    "key_findings": {
      "history": [
        "exertional dyspnea",
        "orthopnea",
        "paroxysmal nocturnal dyspnea",
        "ankle swelling",
        "fatigue"
      ],
      "exam": [
        "raised jugular venous pressure",
        "S3 gallop",
        "bibasilar crackles",
        "pitting edema",
        "displaced apex beat"
      ],
      "labs": [
        "raised BNP or NT-proBNP",
        "hyponatremia in advanced disease"
      ],
      "imaging": [
        "echocardiogram showing the ejection fraction and wall motion",
        "chest X-ray with cardiomegaly, upper lobe venous diversion and Kerley B lines"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "echocardiogram",
        "BNP or NT-proBNP"
      ],
      "criteria": [
        "HFrEF: ejection fraction 40% or less",
        "HFmrEF: ejection fraction 41 to 49%",
        "HFpEF: ejection fraction 50% or more"
      ]
    },
    "management": {
      "first_line": [
        "HFrEF: four drug classes, an ARNI (sacubitril-valsartan) or ACE inhibitor or ARB, an evidence-based beta blocker, a mineralocorticoid receptor antagonist and an SGLT2 inhibitor",
        "loop diuretics for congestion",
        "exercise, vaccination and avoiding excess salt"
      ],
      "next_line": [
        "ICD for an ejection fraction of 35% or less despite three months of therapy",
        "cardiac resynchronization therapy for an ejection fraction of 35% or less with left bundle branch block and a wide QRS",
        "hydralazine with isosorbide dinitrate, especially for Black patients",
        "LVAD or heart transplant in advanced disease"
      ]
    },
    "complications": [
      "acute decompensation",
      "ventricular arrhythmias and sudden death",
      "atrial fibrillation",
      "cardiorenal syndrome",
      "thromboembolism"
    ],
    "confused_with": [],
    "pearls": [
