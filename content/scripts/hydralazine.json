    "rotation": [],
    "class": "Direct arteriolar vasodilator",
    "class_members": [
      "hydralazine"
    ],
    "mechanism": "Relaxes arteriolar smooth muscle, probably by raising cGMP, lowering afterload. It dilates arterioles much more than veins.",
    "pharmacokinetics": [
      "metabolized by acetylation; slow acetylators have higher levels and more lupus-like reactions"
    ],
    "indications": [
      "heart failure with reduced ejection fraction, with isosorbide dinitrate, especially in Black patients",
      "severe hypertension in pregnancy",
      "resistant hypertension"
    ],
    "adverse_effects": [
      "reflex tachycardia",
      "headache",
      "flushing",
      "fluid retention",
      "drug-induced lupus"
    ],
    "contraindications": [
      "angina without a beta blocker, because reflex tachycardia can provoke ischemia"
    ],
    "interactions": [
      "often given with a beta blocker and a diuretic to offset reflex tachycardia and fluid retention"
    ],
    "monitoring": [
      "blood pressure",
      "heart rate",
      "ANA if lupus symptoms appear"
    ],
    "overdose": {
      "features": [
        "hypotension",
        "tachycardia"
      ],
      "treatment": [
        "IV fluids",
        "supportive care"
      ]
    },
    "confused_with": [
      {
        "script_id": "nitrates",
        "how_to_tell_apart": "Hydralazine dilates arterioles and lowers afterload; nitrates dilate veins and lower preload. Together, as isosorbide dinitrate with hydralazine, they treat heart failure."
      }
    ],
    "pearls": [
      "Drug-induced lupus from hydralazine has anti-histone antibodies and usually spares the kidneys and brain.",
      "Hydralazine is a standard choice for severe hypertension in pregnancy, along with labetalol and nifedipine.",
      "The A-HeFT trial showed hydralazine with isosorbide dinitrate lowered mortality in Black patients with heart failure."
    ],
