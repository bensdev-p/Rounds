    "epidemiology": {
      "who": "People with kidney disease or diabetes, or on drugs that raise potassium",
      "risk_factors": [
        "acute kidney injury",
        "chronic kidney disease",
        "ACE inhibitors or ARBs",
        "potassium-sparing diuretics",
        "rhabdomyolysis",
        "adrenal insufficiency"
      ]
    },
    "pathophysiology": "Reduced potassium excretion or a shift out of cells raises serum potassium, which depolarizes heart and muscle cells and slows cardiac conduction.",
    "timeline": {
      "onset": "Acute or chronic",
      "course": "Can cause fatal arrhythmias once ECG changes appear"
    },
    "key_findings": {
      "history": [
        "often no symptoms",
        "muscle weakness",
        "palpitations"
      ],
      "exam": [
        "weakness",
        "bradycardia"
      ],
      "labs": [
        "serum potassium above 5.5 mEq/L",
        "pseudohyperkalemia from a hemolyzed sample",
        "ECG: peaked T waves, then PR prolongation and a wide QRS, progressing to a sine wave"
      ],
      "imaging": []
    },
    "diagnosis": {
      "confirmatory_tests": [
        "repeat serum potassium",
        "12-lead ECG"
      ],
      "criteria": [
        "serum potassium above 5.5 mEq/L; severe at 6.5 mEq/L or above, or with ECG changes"
      ]
    },
    "management": {
      "first_line": [
        "IV calcium gluconate to stabilize the heart",
        "insulin with glucose to shift potassium into cells",
        "beta-2 agonist such as nebulized albuterol"
      ],
      "next_line": [
        "remove potassium: loop diuretics, potassium binders or dialysis",
        "stop potassium-raising drugs"
      ]
    },
    "complications": [
      "ventricular fibrillation",
      "asystole",
      "bradyarrhythmias"
    ],
    "confused_with": [],
    "pearls": [
