    "name": "Hyperosmolar hyperglycemic state",
    "aliases": [
      "HHS"
    ],
    "rotation": [
      "IM",
      "EM"
    ],
    "epidemiology": {
      "who": "Older adults with type 2 diabetes, often with limited access to water",
      "risk_factors": [
        "infection",
        "insufficient insulin or missed medications",
        "myocardial infarction",
        "stroke",
        "glucocorticoids",
        "thiazide diuretics"
      ]
    },
    "pathophysiology": "Relative insulin deficiency, with enough insulin to prevent ketogenesis, causes severe hyperglycemia, an osmotic diuresis, profound dehydration and hyperosmolality.",
    "timeline": {
      "onset": "Develops over days to weeks",
      "course": "Slower to correct than DKA, with a higher mortality"
    },
    "key_findings": {
      "history": [
        "polyuria and polydipsia over days to weeks",
        "weakness",
        "confusion or drowsiness"
      ],
      "exam": [
        "severe dehydration",
        "altered mental status, from lethargy to coma",
        "focal neurologic signs or seizures in some"
      ],
      "labs": [
        "glucose usually above 600 mg/dL",
        "effective serum osmolality above 300 mOsm/kg",
        "pH 7.3 or higher and bicarbonate 15 mEq/L or higher",
        "little or no ketonemia"
      ],
      "imaging": []
    },
    "diagnosis": {
      "confirmatory_tests": [
        "serum glucose",
        "calculated effective serum osmolality",
        "serum beta-hydroxybutyrate to exclude significant ketosis"
      ],
      "criteria": [
        "glucose of 600 mg/dL or more",
        "effective serum osmolality above 300 mOsm/kg (or total above 320)",
        "pH 7.3 or higher, bicarbonate 15 mEq/L or higher, and no significant ketonemia"
      ]
    },
    "management": {
      "first_line": [
        "aggressive IV isotonic fluids",
        "IV insulin infusion once fluids are running and potassium is at least 3.5 mEq/L",
        "potassium replacement"
      ],
      "next_line": [
        "lower glucose, sodium and osmolality gradually to avoid cerebral edema",
        "treat the precipitant",
        "VTE prophylaxis"
      ]
    },
    "complications": [
      "cerebral edema from overly rapid correction",
      "venous thromboembolism",
      "rhabdomyolysis",
      "acute kidney injury"
    ],
    "confused_with": [
      {
        "script_id": "diabetic-ketoacidosis",
        "how_to_tell_apart": "DKA has ketones and an anion gap acidosis and develops over hours; HHS has much higher glucose and osmolality, little or no ketosis, and develops over days."
      }
    ],
    "pearls": [
      "In HHS, fluids come first: insulin before adequate fluid replacement shifts water into cells and can worsen hypotension."
    ],
    "difficulty_tiers": {
      "MS1-2": [
        "pathophysiology"
      ],
