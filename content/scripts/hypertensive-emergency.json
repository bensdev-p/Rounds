    "kind": "disease",
    "name": "Hypertensive emergency",
    "aliases": [
      "hypertensive crisis",
      "malignant hypertension"
    ],
    "systems": [
      "cardio"
    ],
    "rotation": [
      "IM",
      "EM"
    ],
    "epidemiology": {
      "who": "Adults with poorly controlled or untreated hypertension",
      "risk_factors": [
        "nonadherence to antihypertensives",
        "cocaine or amphetamine use",
        "preeclampsia",
        "renal artery stenosis",
        "pheochromocytoma",
        "abrupt clonidine withdrawal"
      ]
    },
    "pathophysiology": "Severely raised blood pressure, usually above 180/120, causes acute damage to the brain, heart, aorta, kidneys and eyes. Without acute organ damage it is called hypertensive urgency.",
    "timeline": {
      "onset": "Hours to days",
      "course": "Life-threatening without prompt, controlled lowering"
    },
    "key_findings": {
      "history": [
        "headache",
        "confusion or seizures (hypertensive encephalopathy)",
        "chest pain",
        "dyspnea",
        "visual changes"
      ],
      "exam": [
        "blood pressure usually above 180/120",
        "papilledema, retinal hemorrhages and exudates",
        "focal neurologic signs"
      ],
      "labs": [
        "creatinine and urinalysis for acute kidney injury",
        "troponin",
        "blood smear for schistocytes (thrombotic microangiopathy)"
      ],
      "imaging": [
        "head CT for stroke or bleeding",
        "chest X-ray for pulmonary edema",
        "CT angiography if aortic dissection is suspected"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "severely raised blood pressure with evidence of acute organ damage"
      ],
      "criteria": [
        "emergency: severe hypertension with acute organ damage; urgency: severe hypertension without it"
      ]
    },
    "management": {
      "first_line": [
        "ICU admission and an IV titratable drug such as nicardipine, clevidipine, labetalol, esmolol or nitroprusside",
        "lower blood pressure by no more than 25% in the first hour, then toward 160/100 over the next 2 to 6 hours"
      ],
      "next_line": [
        "aortic dissection: lower systolic pressure below 120 within 20 minutes, with a beta blocker first",
        "hypertensive urgency: oral drugs and close outpatient follow-up, not rapid IV lowering"
      ]
    },
    "complications": [
      "stroke",
      "hypertensive encephalopathy",
      "acute heart failure with pulmonary edema",
      "myocardial infarction",
      "aortic dissection",
      "acute kidney injury"
    ],
    "confused_with": [
      {
        "script_id": "essential-hypertension",
        "how_to_tell_apart": "A hypertensive emergency is severe hypertension with acute organ damage, needing IV drugs in the ICU; essential hypertension is chronic, silent and treated with oral drugs."
      }
    ],
    "pearls": [
      "Lowering blood pressure too fast can cause stroke or kidney injury, because autoregulation has shifted upward.",
      "Aortic dissection is the exception: lower the pressure fast, with a beta blocker before any vasodilator.",
      "In a cocaine-induced hypertensive crisis, give benzodiazepines first and avoid a beta blocker alone."
    ],
    "difficulty_tiers": {
