      ],
      "criteria": [
        "serum sodium below 135 mEq/L; severe below 120 mEq/L"
      ]
    },
    "management": {
      "first_line": [
        "hypertonic 3% saline bolus for severe symptoms such as seizures",
        "fluid restriction for SIADH",
        "isotonic saline for hypovolemic hyponatremia",
        "stop the offending drug"
      ],
      "next_line": [
        "limit correction to 8 mEq/L in 24 hours in chronic hyponatremia",
        "urea or vaptans for refractory SIADH",
        "treat heart failure or cirrhosis in hypervolemic hyponatremia"
