    "kind": "disease",
    "name": "IgA vasculitis",
    "aliases": [
      "Henoch-Schönlein purpura",
      "HSP"
    ],
    "systems": [
      "cardio",
      "renal",
      "derm"
    ],
    "rotation": [
      "peds"
    ],
    "epidemiology": {
      "who": "Children aged 3 to 15, often after an upper respiratory infection; the most common vasculitis of childhood",
      "risk_factors": [
        "recent upper respiratory infection",
        "childhood",
        "autumn and winter"
      ]
    },
    "pathophysiology": "IgA immune complexes deposit in small vessels of the skin, gut, joints and kidneys, causing a leukocytoclastic vasculitis.",
    "timeline": {
      "onset": "Days to weeks after a respiratory infection",
      "course": "Usually settles in about 4 weeks; kidney disease can persist, more often in adults"
    },
    "key_findings": {
      "history": [
        "rash on the buttocks and legs",
        "joint pain, often in the knees and ankles",
        "colicky abdominal pain",
        "recent upper respiratory infection"
      ],
      "exam": [
        "palpable purpura on the buttocks and lower legs with a normal platelet count",
        "arthritis",
        "swelling of the hands, feet or scrotum"
      ],
      "labs": [
        "normal platelet count and clotting",
        "urinalysis with hematuria or proteinuria",
        "raised serum IgA in some"
      ],
      "imaging": [
        "abdominal ultrasound for intussusception if pain is severe"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "clinical diagnosis",
        "skin or kidney biopsy showing IgA deposits"
      ],
      "criteria": [
        "palpable purpura, mainly on the legs, plus at least one of abdominal pain, arthritis or arthralgia, kidney involvement, or IgA deposits on biopsy"
      ]
    },
    "management": {
      "first_line": [
        "supportive care: rest, fluids, and acetaminophen or NSAIDs for joint pain (avoid NSAIDs with kidney involvement)",
        "monitor the urine and blood pressure for 6 to 12 months"
      ],
      "next_line": [
        "glucocorticoids for severe abdominal pain",
        "immunosuppression for significant nephritis"
      ]
    },
    "complications": [
      "intussusception, usually ileoileal",
      "glomerulonephritis like IgA nephropathy",
      "chronic kidney disease, rarely"
    ],
    "confused_with": [
      {
        "script_id": "kawasaki-disease",
        "how_to_tell_apart": "IgA vasculitis gives palpable purpura on the legs, joint pain, belly pain and hematuria; Kawasaki disease gives prolonged fever, conjunctivitis, oral changes and coronary aneurysms."
      }
    ],
    "pearls": [
      "Palpable purpura with a normal platelet count separates it from thrombocytopenic purpura.",
      "Intussusception in IgA vasculitis is usually ileoileal, unlike the ileocolic type in idiopathic intussusception.",
      "Monitor the urine for months, because kidney disease can appear after the rash has faded."
    ],
    "difficulty_tiers": {
