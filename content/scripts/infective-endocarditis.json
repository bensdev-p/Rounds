    ],
    "epidemiology": {
      "who": "People who inject drugs, and those with prosthetic valves, prior endocarditis or structural heart disease",
      "risk_factors": [
        "injection drug use",
        "prosthetic heart valve",
        "prior endocarditis",
        "structural or congenital heart disease",
        "indwelling intravascular devices",
        "hemodialysis"
      ]
    },
    "pathophysiology": "Bacteria, most often Staphylococcus aureus, seed a heart valve and form vegetations that destroy the valve and shed septic emboli.",
    "timeline": {
      "onset": "Acute over days (S. aureus) or subacute over weeks (viridans streptococci)",
      "course": "Fatal without treatment; many patients need surgery"
    },
    "key_findings": {
      "history": [
        "fever",
        "fatigue and weight loss in subacute disease",
        "new heart failure symptoms"
      ],
      "exam": [
        "new regurgitant murmur",
        "splinter hemorrhages",
        "painless Janeway lesions on the palms and soles",
        "painful Osler nodes on the fingers",
        "Roth spots"
      ],
      "labs": [
        "persistently positive blood cultures",
        "raised inflammatory markers",
        "hematuria from glomerulonephritis"
      ],
      "imaging": [
        "echocardiogram showing a vegetation: transthoracic first, transesophageal if negative or with a prosthetic valve"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "three sets of blood cultures before antibiotics",
        "echocardiogram"
      ],
      "criteria": [
        "Duke criteria: typical organisms in blood cultures and evidence of endocardial involvement are the major criteria"
      ]
    },
    "management": {
      "first_line": [
        "empiric IV vancomycin after blood cultures",
        "prolonged IV antibiotics (4 to 6 weeks) guided by culture results"
      ],
      "next_line": [
        "surgery for heart failure, uncontrolled infection, abscess, or large vegetations with embolism"
      ]
    },
    "complications": [
      "heart failure from valve destruction",
      "septic emboli to the brain, lungs, spleen or kidneys",
      "perivalvular abscess",
      "glomerulonephritis"
    ],
    "confused_with": [],
    "pearls": [
      "Endocarditis in people who inject drugs often affects the tricuspid valve and causes septic pulmonary emboli."
    ],
