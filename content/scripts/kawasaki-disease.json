    "epidemiology": {
      "who": "Children under 5, especially of East Asian descent",
      "risk_factors": [
        "age under 5",
        "East Asian ancestry, especially Japanese or Korean",
        "male sex"
      ]
    },
    "pathophysiology": "An acute medium-vessel vasculitis of unknown cause, possibly an immune response to an infectious trigger in genetically susceptible children. It favors the coronary arteries, where it can cause aneurysms.",
    "timeline": {
      "onset": "Fever lasting 5 days or more",
      "course": "Settles over weeks, but about 25% of untreated children develop coronary aneurysms"
    },
    "key_findings": {
      "history": [
        "fever for 5 days or more",
        "irritability",
        "red eyes without discharge"
      ],
      "exam": [
        "bilateral nonexudative conjunctivitis",
        "oral changes: strawberry tongue, red cracked lips",
        "polymorphous rash",
        "extremity changes: red, swollen hands and feet that later peel",
        "cervical lymphadenopathy, usually one node over 1.5 cm"
      ],
      "labs": [
        "raised ESR or CRP",
        "thrombocytosis in the second week",
        "sterile pyuria",
        "raised ALT"
      ],
      "imaging": [
        "echocardiogram for coronary aneurysms at diagnosis, then 1 to 2 weeks and 4 to 6 weeks after treatment"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "clinical diagnosis",
        "echocardiogram"
      ],
      "criteria": [
        "fever for 5 days or more plus at least 4 of 5 features: conjunctivitis, oral changes, rash, extremity changes, cervical lymphadenopathy"
      ]
    },
    "management": {
      "first_line": [
        "IV immunoglobulin (IVIG), ideally within 10 days of fever onset",
        "aspirin"
      ],
      "next_line": [
        "a second dose of IVIG, or glucocorticoids, for fever that persists",
        "long-term antiplatelet or anticoagulant therapy for large aneurysms"
      ]
    },
    "complications": [
      "coronary artery aneurysms",
      "myocardial infarction",
      "myocarditis",
      "sudden death"
    ],
    "confused_with": [
      {
        "script_id": "iga-vasculitis",
        "how_to_tell_apart": "Kawasaki disease gives prolonged fever, conjunctivitis, oral changes and coronary aneurysms; IgA vasculitis gives palpable purpura on the legs, joint pain, belly pain and hematuria."
      }
    ],
    "pearls": [
      "Kawasaki disease is one of the few reasons to give aspirin to a child despite the risk of Reye syndrome.",
      "The features spell CRASH and burn: conjunctivitis, rash, adenopathy, strawberry tongue, hands and feet, with fever (burn) for 5 days.",
