    "epidemiology": {
      "who": "Congenital forms in children and young adults; acquired forms, more common, in adults on QT-prolonging drugs",
      "risk_factors": [
        "congenital ion channel variants (KCNQ1, KCNH2, SCN5A)",
        "QT-prolonging drugs: antiarrhythmics, macrolides, fluoroquinolones, antipsychotics, methadone, ondansetron",
        "hypokalemia",
        "hypomagnesemia",
        "hypocalcemia",
        "bradycardia",
        "female sex"
      ]
    },
    "pathophysiology": "Delayed ventricular repolarization lengthens the QT interval. Early afterdepolarizations can trigger torsades de pointes, a polymorphic ventricular tachycardia that can degenerate into ventricular fibrillation.",
    "timeline": {
      "onset": "Congenital: syncope or arrest in childhood or youth, often with a trigger; acquired: after a new drug or electrolyte loss",
      "course": "Torsades can cause sudden death"
    },
    "key_findings": {
      "history": [
        "syncope with exercise, swimming, a sudden loud noise or emotion",
        "palpitations",
        "family history of sudden death",
        "congenital deafness (Jervell and Lange-Nielsen syndrome)"
      ],
      "exam": [
        "often normal"
      ],
      "labs": [
        "potassium, magnesium and calcium"
      ],
      "imaging": [
        "ECG with a prolonged QTc: 480 ms or more, or 460 ms or more with unexplained syncope, supports the diagnosis"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "12-lead ECG with the corrected QT (QTc)",
        "genetic testing for congenital forms"
      ],
      "criteria": [
        "a QTc of 500 ms or more carries a high risk of torsades"
      ]
    },
    "management": {
      "first_line": [
        "stop QT-prolonging drugs",
        "correct potassium and magnesium",
        "beta blockers (nadolol or propranolol) for congenital long QT"
      ],
      "next_line": [
        "IV magnesium for torsades de pointes",
        "overdrive pacing, or isoproterenol for acquired pause-dependent torsades (not in congenital long QT)",
        "ICD for survivors of cardiac arrest"
      ]
    },
    "complications": [
      "torsades de pointes",
      "ventricular fibrillation",
      "sudden cardiac death"
    ],
    "confused_with": [
      {
        "script_id": "ventricular-tachycardia",
        "how_to_tell_apart": "Long QT syndrome causes polymorphic VT (torsades de pointes) with a long QT between episodes, treated with magnesium; scar-related VT is usually monomorphic, with structural heart disease."
      }
    ],
    "pearls": [
      "Typical triggers by type: exercise or swimming in type 1, a sudden noise in type 2, sleep in type 3.",
      "Romano-Ward syndrome is autosomal dominant; Jervell and Lange-Nielsen syndrome is autosomal recessive with deafness.",
      "Check the QTc before starting drugs such as methadone, haloperidol or ondansetron in high-risk patients."
    ],
