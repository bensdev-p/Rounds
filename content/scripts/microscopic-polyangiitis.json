    "kind": "disease",
    "name": "Microscopic polyangiitis",
    "aliases": [
      "MPA"
    ],
    "systems": [
      "cardio",
      "renal",
      "pulm"
    ],
    "rotation": [
      "IM"
    ],
    "epidemiology": {
      "who": "Adults, usually aged 50 to 70",
      "risk_factors": [
        "older age",
        "silica exposure",
        "drugs such as hydralazine and propylthiouracil (drug-induced ANCA vasculitis)"
      ]
    },
    "pathophysiology": "A necrotizing small-vessel vasculitis without granulomas, usually with MPO-ANCA (p-ANCA). It mainly affects the kidneys, as a pauci-immune glomerulonephritis, and the lungs, with capillaritis and hemorrhage.",
    "timeline": {
      "onset": "Weeks to months",
      "course": "Fatal untreated; relapses are less common than in granulomatosis with polyangiitis"
    },
    "key_findings": {
      "history": [
        "fever, weight loss and muscle pain",
        "hemoptysis",
        "dark urine",
        "numbness or weakness from mononeuritis multiplex"
      ],
      "exam": [
        "palpable purpura",
        "no upper airway or sinus disease"
      ],
      "labs": [
        "positive MPO-ANCA (p-ANCA)",
        "hematuria with red cell casts",
        "rising creatinine"
      ],
      "imaging": [
        "chest CT with diffuse alveolar hemorrhage or fibrosis"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "MPO-ANCA",
        "kidney biopsy showing pauci-immune necrotizing crescentic glomerulonephritis"
      ],
      "criteria": []
    },
    "management": {
      "first_line": [
        "induction with glucocorticoids plus rituximab or cyclophosphamide"
      ],
      "next_line": [
        "maintenance with rituximab or azathioprine",
        "trimethoprim-sulfamethoxazole to prevent Pneumocystis pneumonia"
      ]
    },
    "complications": [
      "rapidly progressive glomerulonephritis",
      "diffuse alveolar hemorrhage",
      "end-stage kidney disease"
    ],
    "confused_with": [
      {
        "script_id": "granulomatosis-with-polyangiitis",
        "how_to_tell_apart": "Microscopic polyangiitis has no granulomas and no upper airway disease and is usually MPO-ANCA; granulomatosis with polyangiitis involves the sinuses and nose, has granulomas and is usually PR3-ANCA."
      },
      {
        "script_id": "polyarteritis-nodosa",
        "how_to_tell_apart": "Microscopic polyangiitis inflames small vessels, causes glomerulonephritis and lung hemorrhage and is usually MPO-ANCA positive; polyarteritis nodosa inflames medium arteries, spares the lungs and glomeruli and is ANCA-negative."
      }
    ],
    "pearls": [
      "Pauci-immune means few or no immune deposits on immunofluorescence, unlike lupus nephritis or anti-GBM disease.",
      "No granulomas and no upper airway disease separate it from granulomatosis with polyangiitis.",
      "Hydralazine and propylthiouracil can cause drug-induced MPO-ANCA vasculitis."
    ],
    "difficulty_tiers": {
