    "class": "Mineralocorticoid receptor antagonists (potassium-sparing diuretics)",
    "class_members": [
      "spironolactone",
      "eplerenone",
      "finerenone"
    ],
    "mechanism": "Block the aldosterone (mineralocorticoid) receptor in the collecting duct, so less sodium is reabsorbed and less potassium and hydrogen are excreted. They also block aldosterone's fibrosis-promoting effects on the heart.",
    "pharmacokinetics": [
      "spironolactone has active metabolites and takes days to reach full effect",
      "eplerenone is more selective and metabolized by CYP3A4"
    ],
    "indications": [
      "heart failure with reduced ejection fraction",
      "primary hyperaldosteronism",
      "resistant hypertension",
      "ascites from cirrhosis",
      "diabetic kidney disease (finerenone)",
      "acne and hirsutism (spironolactone)"
    ],
    "adverse_effects": [
      "hyperkalemia",
      "gynecomastia with spironolactone",
      "menstrual irregularity",
      "metabolic acidosis",
      "rise in creatinine"
    ],
    "contraindications": [
      "potassium above 5.0",
      "eGFR below 30, for heart failure use"
    ],
    "interactions": [
      "ACE inhibitors, ARBs and potassium supplements raise potassium further",
      "strong CYP3A4 inhibitors raise eplerenone levels"
    ],
    "monitoring": [
      "potassium and creatinine at 3 days, 1 week, then monthly for 3 months"
    ],
    "overdose": {
      "features": [
        "hyperkalemia"
      ],
      "treatment": [
        "stop the drug and treat hyperkalemia"
      ]
    },
