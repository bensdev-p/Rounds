    "epidemiology": {
      "who": "Adults; primary disease from a damaged valve such as mitral valve prolapse, secondary disease from a dilated left ventricle",
      "risk_factors": [
        "mitral valve prolapse",
        "myocardial infarction with papillary muscle rupture",
        "dilated cardiomyopathy",
        "rheumatic heart disease",
        "infective endocarditis"
      ]
    },
    "pathophysiology": "Blood leaks back from the left ventricle into the left atrium in systole. In chronic disease the atrium and ventricle dilate to cope with the extra volume. Acute regurgitation, such as papillary muscle rupture after an MI, floods a normal-sized atrium and causes pulmonary edema.",
    "timeline": {
      "onset": "Acute (hours, after an MI or endocarditis) or chronic (years)",
      "course": "Chronic disease is tolerated for years before the ventricle fails"
    },
    "key_findings": {
      "history": [
        "exertional dyspnea",
        "fatigue",
        "palpitations from atrial fibrillation",
        "sudden pulmonary edema in acute disease"
      ],
      "exam": [
        "holosystolic blowing murmur at the apex radiating to the axilla",
        "soft S1",
        "S3 from volume overload",
        "displaced apex beat"
      ],
      "labs": [
        "raised BNP as the ventricle fails"
      ],
      "imaging": [
        "echocardiogram showing the regurgitant jet and its cause",
        "chest X-ray with an enlarged left atrium"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "transthoracic echocardiogram",
        "transesophageal echocardiogram to plan repair"
      ],
      "criteria": [
        "severe primary regurgitation with symptoms, or with a left ventricular ejection fraction of 60% or less, is an indication for intervention"
      ]
    },
    "management": {
      "first_line": [
        "surgical mitral valve repair, preferred over replacement, for severe primary regurgitation with symptoms or ventricular dysfunction",
        "guideline-directed heart failure therapy for secondary regurgitation"
      ],
      "next_line": [
        "transcatheter edge-to-edge repair (MitraClip) when surgical risk is high",
        "urgent surgery for acute regurgitation from papillary muscle rupture"
      ]
    },
    "complications": [
      "atrial fibrillation",
      "heart failure",
      "pulmonary hypertension",
      "infective endocarditis"
    ],
