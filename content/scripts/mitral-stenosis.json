    "epidemiology": {
      "who": "Women more than men, decades after rheumatic fever; common where rheumatic heart disease persists",
      "risk_factors": [
        "rheumatic heart disease",
        "mitral annular calcification in older adults",
        "congenital mitral stenosis, rarely"
      ]
    },
    "pathophysiology": "Rheumatic scarring fuses the commissures and thickens the leaflets, narrowing the mitral orifice. Left atrial pressure rises, the atrium enlarges, and pressure backs up into the lungs, causing pulmonary hypertension.",
    "timeline": {
      "onset": "Symptoms 20 to 40 years after rheumatic fever",
      "course": "Slowly progressive; pregnancy, atrial fibrillation or exercise can unmask it"
    },
    "key_findings": {
      "history": [
        "exertional dyspnea",
        "orthopnea",
        "hemoptysis",
        "palpitations from atrial fibrillation",
        "hoarseness from left atrial pressure on the recurrent laryngeal nerve (Ortner syndrome)",
        "stroke from embolism"
      ],
      "exam": [
        "opening snap after S2",
        "mid-diastolic rumble at the apex, heard best with the bell in the left lateral position",
        "loud S1",
        "malar flush"
      ],
      "labs": [],
      "imaging": [
        "echocardiogram showing fused commissures, thickened leaflets and a small valve area",
        "chest X-ray with an enlarged left atrium",
        "ECG with left atrial enlargement or atrial fibrillation"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "transthoracic echocardiogram"
      ],
      "criteria": [
        "severe mitral stenosis: a valve area of 1.5 square centimeters or less"
      ]
    },
    "management": {
      "first_line": [
        "percutaneous balloon mitral commissurotomy for severe symptomatic stenosis with favorable valve anatomy",
        "beta blockers or other rate control to lengthen diastole",
        "warfarin for atrial fibrillation or prior embolism"
      ],
      "next_line": [
        "surgical mitral valve replacement when balloon commissurotomy is unsuitable",
        "diuretics for congestion"
      ]
    },
    "complications": [
      "atrial fibrillation",
      "left atrial thrombus",
      "stroke",
      "pulmonary hypertension",
      "right heart failure",
      "hemoptysis"
    ],
    "confused_with": [
      {
        "script_id": "aortic-regurgitation",
        "how_to_tell_apart": "Mitral stenosis is a mid-diastolic rumble at the apex after an opening snap; aortic regurgitation is an early diastolic decrescendo murmur at the left sternal border with a wide pulse pressure."
      }
    ],
    "pearls": [
      "A shorter interval between S2 and the opening snap means more severe stenosis.",
      "In rheumatic mitral stenosis with atrial fibrillation, warfarin is used rather than a direct oral anticoagulant.",
      "Pregnancy often unmasks mitral stenosis, because blood volume and heart rate rise."
    ],
