        "the click moves earlier with Valsalva or standing and later with squatting or handgrip"
      ],
      "labs": [],
      "imaging": [
        "echocardiogram showing a leaflet displaced more than 2 mm into the left atrium"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "transthoracic echocardiogram"
      ],
      "criteria": [
        "systolic displacement of a mitral leaflet more than 2 mm above the annulus"
      ]
    },
    "management": {
      "first_line": [
