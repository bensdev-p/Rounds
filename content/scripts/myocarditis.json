    "epidemiology": {
      "who": "Children and young adults, more often males",
      "risk_factors": [
        "viral infection, such as coxsackievirus B, parvovirus B19, adenovirus or SARS-CoV-2",
        "mRNA COVID-19 vaccination, rarely, mostly in young men",
        "immune checkpoint inhibitors",
        "Chagas disease",
        "autoimmune disease, as in giant cell myocarditis",
        "hypersensitivity to drugs"
      ]
    },
    "pathophysiology": "Inflammation of the heart muscle, usually from a viral infection and the immune response to it, injures myocytes and can lead to heart failure, arrhythmias or dilated cardiomyopathy.",
    "timeline": {
      "onset": "Days to weeks after a viral illness",
      "course": "Most recover; some develop dilated cardiomyopathy; fulminant cases need mechanical support"
    },
    "key_findings": {
      "history": [
        "recent flu-like or gastrointestinal illness",
        "chest pain",
        "dyspnea and fatigue",
        "palpitations or syncope"
      ],
      "exam": [
        "tachycardia out of proportion to fever",
        "signs of heart failure",
        "S3"
      ],
      "labs": [
        "raised troponin",
        "raised CRP or ESR",
        "raised BNP"
      ],
      "imaging": [
        "ECG with ST changes, arrhythmias or heart block",
        "echocardiogram with reduced function and wall motion abnormalities",
        "cardiac MRI with late gadolinium enhancement in a nonischemic, subepicardial pattern",
        "coronary angiography to exclude a heart attack"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "cardiac MRI",
        "endomyocardial biopsy for severe or unexplained cases"
      ],
      "criteria": [
        "raised troponin with typical MRI findings and no significant coronary disease"
      ]
    },
    "management": {
      "first_line": [
        "supportive care and guideline-directed heart failure therapy",
        "no competitive sport for 3 to 6 months"
      ],
      "next_line": [
        "mechanical circulatory support for fulminant myocarditis",
        "immunosuppression for giant cell or eosinophilic myocarditis",
        "high-dose glucocorticoids for checkpoint inhibitor myocarditis"
      ]
    },
    "complications": [
      "dilated cardiomyopathy",
      "heart failure",
      "ventricular arrhythmias and sudden death",
      "heart block"
    ],
    "confused_with": [
      {
        "script_id": "acute-pericarditis",
        "how_to_tell_apart": "Myocarditis inflames the heart muscle, raising troponin and weakening contraction; pericarditis inflames the pericardium, causing pleuritic pain, a rub and PR depression, with troponin normal unless the muscle is involved."
      }
    ],
    "pearls": [
      "Coxsackievirus B is the classic cause.",
      "Athletes should avoid competitive sport for 3 to 6 months after myocarditis, because of the risk of sudden death.",
