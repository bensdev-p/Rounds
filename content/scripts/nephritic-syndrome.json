    "epidemiology": {
      "who": "Children and adults; post-infectious glomerulonephritis is common in children, and IgA nephropathy is the most common glomerulonephritis worldwide",
      "risk_factors": [
        "post-streptococcal glomerulonephritis",
        "IgA nephropathy",
        "lupus nephritis",
        "ANCA-associated vasculitis",
        "anti-GBM disease",
        "infective endocarditis"
      ]
    },
    "pathophysiology": "Immune-mediated inflammation of the glomeruli damages the capillary walls, letting red cells into the urine and lowering filtration, which causes salt and water retention, hypertension and a rising creatinine.",
    "timeline": {
      "onset": "Days to weeks",
      "course": "Post-streptococcal disease usually resolves in children; rapidly progressive forms can cause kidney failure within weeks"
    },
    "key_findings": {
      "history": [
        "cola-colored urine",
        "reduced urine output",
        "recent sore throat or skin infection"
      ],
      "exam": [
        "hypertension",
        "periorbital or leg edema"
      ],
      "labs": [
        "hematuria with red blood cell casts and dysmorphic red cells",
        "rising creatinine",
        "proteinuria usually below 3.5 g/day",
        "low complement C3 in post-streptococcal glomerulonephritis and lupus nephritis"
      ],
      "imaging": []
    },
    "diagnosis": {
      "confirmatory_tests": [
        "urinalysis with microscopy for red blood cell casts",
        "complement levels (C3 and C4)",
        "serologies: ANCA, anti-GBM, ANA, ASO",
        "kidney biopsy"
      ],
      "criteria": [
        "hematuria with red cell casts, hypertension, edema and reduced kidney function"
      ]
    },
    "management": {
      "first_line": [
        "supportive care",
        "blood pressure control",
        "loop diuretics and salt restriction for fluid overload",
        "treat the underlying cause"
      ],
      "next_line": [
        "immunosuppression (steroids with cyclophosphamide or rituximab) for rapidly progressive disease such as ANCA vasculitis",
        "plasma exchange for anti-GBM disease",
        "dialysis for refractory fluid overload, hyperkalemia or uremia"
      ]
    },
    "complications": [
      "acute kidney injury",
      "hypertensive emergency",
      "pulmonary edema",
      "progression to chronic kidney disease"
    ],
