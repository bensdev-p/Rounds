      "reflex tachycardia",
      "tolerance with continuous use"
    ],
    "contraindications": [
      "use of a PDE5 inhibitor: sildenafil in the past 24 hours or tadalafil in the past 48 hours",
      "right ventricular infarction",
      "severe aortic stenosis",
      "hypertrophic obstructive cardiomyopathy"
    ],
    "interactions": [
