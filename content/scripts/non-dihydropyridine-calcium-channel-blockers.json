    "class": "Non-dihydropyridine calcium channel blockers (class IV antiarrhythmics)",
    "class_members": [
      "verapamil",
      "diltiazem"
    ],
    "mechanism": "Block L-type calcium channels mainly in the heart, slowing the SA node, slowing conduction through the AV node and reducing contractility. They dilate arteries less than dihydropyridines do.",
    "pharmacokinetics": [
      "both are metabolized by the liver and inhibit CYP3A4",
      "IV diltiazem is used for quick rate control"
    ],
    "indications": [
      "rate control in atrial fibrillation or flutter",
      "supraventricular tachycardia",
      "stable angina",
      "vasospastic angina",
      "hypertension",
      "cluster headache prevention (verapamil)"
    ],
    "adverse_effects": [
      "bradycardia",
      "AV block",
      "constipation, especially with verapamil",
      "worsening heart failure",
      "hypotension",
      "peripheral edema",
      "gingival hyperplasia"
    ],
    "contraindications": [
      "heart failure with reduced ejection fraction",
      "second- or third-degree AV block or sick sinus syndrome",
      "atrial fibrillation with Wolff-Parkinson-White syndrome",
      "hypotension"
    ],
    "interactions": [
      "beta blockers add to bradycardia and AV block",
      "they inhibit CYP3A4, raising levels of simvastatin and other drugs",
      "raise digoxin levels"
    ],
    "monitoring": [
      "heart rate",
