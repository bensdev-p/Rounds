      "who": "Adults over 50, especially smokers and people with diabetes",
      "risk_factors": [
        "smoking",
        "diabetes",
        "hypertension",
        "hyperlipidemia",
        "older age",
        "chronic kidney disease"
      ]
    },
    "pathophysiology": "Atherosclerosis narrows the leg arteries, so blood flow cannot rise with exercise and the muscles become ischemic. Severe disease causes pain at rest, ulcers and gangrene.",
    "timeline": {
      "onset": "Gradual over years",
      "course": "Most stay stable; a minority progress to limb-threatening ischemia; the risk of heart attack and stroke is high"
    },
    "key_findings": {
      "history": [
        "intermittent claudication: calf pain on walking, relieved by rest",
        "rest pain in the foot, worse with the leg raised",
        "nonhealing ulcers"
      ],
      "exam": [
        "weak or absent pedal pulses",
        "cool, hairless, shiny skin",
        "delayed capillary refill",
        "dependent rubor, with pallor on elevation",
        "arterial ulcers on the toes and pressure points"
      ],
      "labs": [
        "lipid panel and HbA1c"
      ],
      "imaging": [
        "ankle-brachial index",
        "toe-brachial index when the arteries are incompressible",
        "duplex ultrasound, CT or MR angiography to plan revascularization"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "ankle-brachial index"
      ],
      "criteria": [
        "an ABI of 0.90 or less is diagnostic; above 1.40 means stiff, incompressible arteries"
      ]
    },
    "management": {
      "first_line": [
        "supervised exercise therapy",
        "stop smoking",
        "high-intensity statin",
        "antiplatelet therapy with aspirin or clopidogrel",
        "blood pressure and diabetes control"
      ],
      "next_line": [
        "cilostazol for claudication",
        "revascularization, endovascular or bypass, for lifestyle-limiting claudication or limb-threatening ischemia",
        "low-dose rivaroxaban with aspirin in selected patients"
      ]
    },
    "complications": [
      "chronic limb-threatening ischemia",
      "amputation",
      "myocardial infarction",
      "stroke"
    ],
    "confused_with": [],
    "pearls": [
      "Neurogenic claudication from spinal stenosis improves with sitting or bending forward; vascular claudication improves with standing still.",
      "Cilostazol is contraindicated in heart failure.",
      "An ABI above 1.40 means stiff, calcified arteries, common in diabetes and kidney disease; use the toe-brachial index instead."
    ],
