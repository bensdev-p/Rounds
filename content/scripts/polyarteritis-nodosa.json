      "who": "Middle-aged adults; linked to hepatitis B",
      "risk_factors": [
        "hepatitis B infection",
        "hairy cell leukemia",
        "hepatitis C, less often"
      ]
    },
    "pathophysiology": "Necrotizing inflammation of medium-sized muscular arteries, with segmental lesions of different ages and microaneurysms. It spares the lungs and the glomeruli and is not associated with ANCA.",
    "timeline": {
      "onset": "Weeks to months of systemic symptoms",
      "course": "Fatal untreated; most remit with treatment and rarely relapse"
    },
    "key_findings": {
      "history": [
        "fever, weight loss and muscle pain",
        "abdominal pain after meals from mesenteric ischemia",
        "testicular pain",
        "foot or wrist drop from mononeuritis multiplex"
      ],
      "exam": [
        "livedo reticularis",
        "subcutaneous nodules and skin ulcers",
        "new hypertension"
      ],
      "labs": [
        "raised ESR or CRP",
        "negative ANCA",
        "positive hepatitis B surface antigen in some"
      ],
      "imaging": [
        "mesenteric or renal angiography with microaneurysms and stenoses"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "biopsy of affected skin, nerve or muscle showing necrotizing arteritis",
        "angiography showing microaneurysms"
      ],
      "criteria": []
    },
    "management": {
      "first_line": [
        "glucocorticoids, plus cyclophosphamide for severe disease",
        "hepatitis B related disease: antivirals with a short course of glucocorticoids"
      ],
      "next_line": [
        "azathioprine or methotrexate for maintenance"
      ]
    },
    "complications": [
      "bowel infarction",
      "kidney infarction and hypertension",
      "myocardial infarction",
      "stroke"
    ],
    "confused_with": [
