    "epidemiology": {
      "who": "Adults with risk factors for venous thromboembolism",
      "risk_factors": [
        "recent surgery",
        "immobilization",
        "active cancer",
        "prior VTE",
        "estrogen use or pregnancy",
        "inherited thrombophilia"
      ]
    },
    "pathophysiology": "A thrombus, usually from the deep veins of the legs, lodges in the pulmonary arteries, causing ventilation-perfusion mismatch and hypoxemia; a large clot strains the right ventricle and can cause shock.",
    "timeline": {
      "onset": "Sudden",
      "course": "Most stable patients recover with anticoagulation; massive PE can cause sudden death"
    },
    "key_findings": {
      "history": [
        "sudden dyspnea",
        "pleuritic chest pain",
        "hemoptysis",
        "unilateral leg swelling"
      ],
      "exam": [
        "tachycardia",
        "tachypnea",
        "hypoxemia",
        "clear lungs"
      ],
      "labs": [
        "raised D-dimer",
        "raised troponin or BNP with right ventricular strain"
      ],
      "imaging": [
        "CT pulmonary angiography showing a filling defect",
        "echocardiogram may show right ventricular dilation"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "CT pulmonary angiography",
        "V/Q scan if CT contrast is contraindicated"
      ],
      "criteria": [
        "use the Wells score to estimate pretest probability",
        "with low pretest probability, a negative D-dimer rules out PE"
      ]
    },
    "management": {
      "first_line": [
        "anticoagulation, preferably a direct oral anticoagulant such as apixaban or rivaroxaban"
      ],
      "next_line": [
        "systemic thrombolysis for high-risk PE with hypotension",
        "catheter-directed therapy or surgical embolectomy if thrombolysis fails or is contraindicated",
        "IVC filter only if anticoagulation is contraindicated"
      ]
    },
    "complications": [
      "right heart failure",
      "obstructive shock",
      "pulmonary infarction",
      "chronic thromboembolic pulmonary hypertension"
    ],
    "confused_with": [
      {
        "script_id": "community-acquired-pneumonia",
        "how_to_tell_apart": "Pneumonia usually brings fever, productive cough, focal crackles and a consolidation on chest X-ray; PE more often has clear lungs and a near-normal X-ray despite hypoxemia."
      }
    ],
    "pearls": [
      "The most common ECG finding in PE is sinus tachycardia; the classic S1Q3T3 pattern is uncommon."
    ],
