    "kind": "pathway",
    "name": "Renin-angiotensin-aldosterone system",
    "aliases": [
      "RAAS",
      "renin-angiotensin system"
    ],
    "systems": [
      "cardio",
      "renal",
      "endo"
    ],
    "rotation": [],
    "location": "Kidney (juxtaglomerular cells), liver, lungs, adrenal cortex and blood vessels",
    "purpose": "Keeps up blood pressure and blood volume by constricting arterioles and making the kidney hold on to sodium and water.",
    "steps": [
      "juxtaglomerular cells release renin when renal perfusion falls, when the macula densa senses low sodium chloride, or on beta-1 stimulation",
      "renin cleaves angiotensinogen, made by the liver, to angiotensin I",
      "angiotensin-converting enzyme, mostly in the lungs, converts angiotensin I to angiotensin II and breaks down bradykinin",
      "angiotensin II constricts arterioles and the efferent arteriole, releases aldosterone and ADH, triggers thirst and increases proximal sodium reabsorption",
      "aldosterone acts on the collecting duct to reabsorb sodium and excrete potassium and hydrogen"
    ],
    "rate_limiting_enzyme": "renin",
    "regulation": [
      "low renal perfusion pressure raises renin",
      "low sodium chloride at the macula densa raises renin",
      "sympathetic beta-1 stimulation raises renin",
      "angiotensin II and ANP lower renin release",
      "high potassium stimulates aldosterone directly"
    ],
    "cofactors": [],
    "deficiencies": [
      "primary hyperaldosteronism: high aldosterone with low renin, causing hypertension and hypokalemia",
      "renal artery stenosis: high renin with high aldosterone (secondary hyperaldosteronism)",
      "Addison disease: low aldosterone with high renin, causing hyperkalemia and hypotension",
      "Bartter and Gitelman syndromes: high renin and aldosterone with normal blood pressure"
    ],
    "drug_targets": [
      "aliskiren inhibits renin",
      "ACE inhibitors block angiotensin-converting enzyme",
      "ARBs block the AT1 receptor",
      "spironolactone and eplerenone block the aldosterone receptor",
      "beta blockers reduce renin release"
    ],
    "treatment": [
      "primary hyperaldosteronism: spironolactone, or adrenalectomy for a single adenoma",
      "Addison disease: fludrocortisone with hydrocortisone"
    ],
    "confused_with": [],
    "pearls": [
      "ANP and BNP oppose the RAAS: they dilate vessels and cause sodium loss.",
      "The aldosterone-to-renin ratio screens for primary hyperaldosteronism.",
      "Angiotensin II constricts the efferent arteriole more than the afferent, which keeps GFR up when perfusion falls."
    ],
