    "pathophysiology": "Stiff ventricles fill poorly in diastole, with normal or near-normal wall thickness and systolic function (thick walls in infiltrative disease such as amyloidosis). Filling pressures rise, causing heart failure with a preserved ejection fraction and large atria.",
    "timeline": {
      "onset": "Gradual",
      "course": "Progressive; the outlook depends on the cause and is poor in amyloidosis"
    },
    "key_findings": {
      "history": [
        "exertional dyspnea",
        "fatigue",
        "leg swelling",
        "abdominal swelling"
      ],
      "exam": [
        "raised jugular venous pressure that rises on inspiration (Kussmaul sign)",
        "S3",
        "edema and ascites"
      ],
      "labs": [
        "raised BNP",
        "serum free light chains and immunofixation for AL amyloidosis"
      ],
      "imaging": [
        "echocardiogram with normal-sized ventricles, large atria and diastolic dysfunction",
        "low-voltage ECG despite thick walls in amyloidosis",
        "cardiac MRI with late gadolinium enhancement",
        "technetium pyrophosphate scan, which diagnoses transthyretin amyloidosis without a biopsy once light-chain tests rule out AL amyloidosis"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "echocardiogram",
        "cardiac MRI",
        "endomyocardial biopsy when the cause is unclear"
      ],
      "criteria": []
    },
    "management": {
      "first_line": [
        "diuretics for congestion",
        "treat the cause: tafamidis or acoramidis (stabilizers) or vutrisiran (a silencer) for transthyretin amyloidosis, chemotherapy for AL amyloidosis, phlebotomy for hemochromatosis"
      ],
      "next_line": [
        "heart transplant in selected patients"
      ]
    },
    "complications": [
      "heart failure",
      "atrial fibrillation",
      "thromboembolism",
      "sudden death"
    ],
    "confused_with": [
      {
        "script_id": "constrictive-pericarditis",
        "how_to_tell_apart": "Both fill poorly and raise venous pressure, but restrictive cardiomyopathy has stiff heart muscle, a high BNP and a normal pericardium; constrictive pericarditis has a thick, often calcified pericardium, a pericardial knock and a lower BNP.",
        "compare": [
          {
