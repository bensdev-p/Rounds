    "epidemiology": {
      "who": "Children aged 5 to 15, 2 to 4 weeks after untreated group A streptococcal pharyngitis; now rare in high-income countries",
      "risk_factors": [
        "untreated group A streptococcal pharyngitis",
        "crowded housing",
        "poverty",
        "prior rheumatic fever"
      ]
    },
    "pathophysiology": "Antibodies against the streptococcal M protein cross-react with heart, joint, brain and skin tissue (molecular mimicry, a type II hypersensitivity). Carditis can leave lasting valve damage, called rheumatic heart disease.",
    "timeline": {
      "onset": "2 to 4 weeks after a sore throat",
      "course": "The acute illness settles over weeks to months; valve damage can progress for decades"
    },
    "key_findings": {
      "history": [
        "recent sore throat",
        "migrating joint pain",
        "jerky involuntary movements (Sydenham chorea)"
      ],
      "exam": [
        "migratory polyarthritis of large joints",
        "carditis with a new murmur, often mitral regurgitation",
        "erythema marginatum",
        "subcutaneous nodules",
        "Sydenham chorea"
      ],
      "labs": [
        "raised ASO or anti-DNase B titers",
        "raised ESR or CRP",
        "prolonged PR interval on ECG"
      ],
      "imaging": [
        "echocardiogram showing valvulitis, most often mitral regurgitation"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "evidence of recent group A strep infection: ASO or anti-DNase B titers, or a positive throat culture"
      ],
      "criteria": [
        "Jones criteria (2015 revision): 2 major, or 1 major plus 2 minor, with evidence of strep infection; recurrences can also be diagnosed with 3 minor criteria",
        "major criteria: carditis, clinical or found only on echo, arthritis, chorea, erythema marginatum, subcutaneous nodules",
        "minor criteria: fever, arthralgia, raised ESR or CRP, prolonged PR interval",
        "thresholds for arthritis and the minor criteria are lower in moderate- and high-risk populations; a prolonged PR does not count when carditis is counted, nor arthralgia when arthritis is"
      ]
    },
    "management": {
      "first_line": [
        "penicillin to clear the streptococcus",
        "high-dose aspirin or NSAIDs for the arthritis"
      ],
      "next_line": [
        "secondary prophylaxis with benzathine penicillin G injections every 3 to 4 weeks for years",
        "glucocorticoids considered for severe carditis"
      ]
    },
    "complications": [
      "rheumatic heart disease",
      "mitral stenosis decades later",
      "heart failure",
      "atrial fibrillation"
    ],
    "confused_with": [],
    "pearls": [
      "Mitral stenosis is the classic late valve lesion of rheumatic heart disease.",
      "Treating strep throat within 9 days prevents rheumatic fever; it does not prevent post-streptococcal glomerulonephritis.",
      "Aschoff bodies, which contain Anitschkow cells, are the histologic hallmark of rheumatic carditis."
    ],
