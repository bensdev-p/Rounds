    "class": "Angiotensin receptor-neprilysin inhibitor (ARNI)",
    "class_members": [
      "sacubitril-valsartan"
    ],
    "mechanism": "Sacubitril inhibits neprilysin, the enzyme that breaks down natriuretic peptides, bradykinin and other vasoactive peptides, so natriuretic peptides rise and cause vasodilation and sodium loss. Valsartan blocks the AT1 receptor; it is needed because neprilysin also breaks down angiotensin II.",
    "pharmacokinetics": [
      "sacubitril is a prodrug",
      "BNP rises on treatment because neprilysin breaks it down; NT-proBNP does not"
    ],
    "indications": [
      "heart failure with reduced ejection fraction, first-line in place of an ACE inhibitor or ARB",
      "heart failure with mildly reduced or preserved ejection fraction, in selected patients"
    ],
    "adverse_effects": [
      "hypotension",
      "hyperkalemia",
      "rise in creatinine",
      "angioedema"
    ],
    "contraindications": [
      "within 36 hours of an ACE inhibitor",
      "history of angioedema",
      "pregnancy"
    ],
    "interactions": [
      "never combine with an ACE inhibitor: neprilysin and ACE both break down bradykinin, so the risk of angioedema rises"
    ],
    "monitoring": [
      "blood pressure",
      "potassium and creatinine"
    ],
