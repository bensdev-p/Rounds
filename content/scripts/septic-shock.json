    "epidemiology": {
      "who": "Anyone with an infection; highest risk in older adults and the immunocompromised",
      "risk_factors": [
        "pneumonia",
        "urinary tract infection",
        "intra-abdominal infection",
        "skin and soft tissue infection",
        "indwelling lines or catheters"
      ]
    },
    "pathophysiology": "A dysregulated host response to infection causes vasodilation, capillary leak and organ dysfunction.",
    "timeline": {
      "onset": "Hours",
      "course": "Mortality rises with each hour of delayed antibiotics in septic shock"
    },
    "key_findings": {
      "history": [
        "fever or chills",
        "confusion",
        "symptoms of the source infection"
      ],
      "exam": [
        "hypotension",
        "tachycardia",
        "tachypnea",
        "altered mental status",
        "warm or mottled skin"
      ],
      "labs": [
        "lactate above 2 mmol/L",
        "signs of organ dysfunction: rising creatinine or bilirubin, low platelets"
      ],
      "imaging": [
        "imaging to find the source, guided by symptoms"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "blood cultures before antibiotics",
        "serum lactate",
        "SOFA score for organ dysfunction"
      ],
      "criteria": [
        "sepsis: suspected infection with an acute rise of 2 or more SOFA points",
        "septic shock: vasopressors needed to keep MAP at 65 mmHg or more, with lactate above 2 mmol/L despite fluids"
      ]
    },
    "management": {
      "first_line": [
        "broad-spectrum antibiotics within 1 hour",
        "30 mL/kg IV crystalloid for hypotension or lactate of 4 mmol/L or more",
        "norepinephrine if hypotension persists"
      ],
      "next_line": [
        "source control",
        "add vasopressin for rising norepinephrine needs",
        "hydrocortisone for refractory shock"
      ]
    },
    "complications": [
      "multi-organ failure",
      "ARDS",
      "acute kidney injury",
      "disseminated intravascular coagulation",
      "death"
    ],
    "confused_with": [
      {
        "script_id": "adrenal-insufficiency",
        "how_to_tell_apart": "Adrenal crisis also causes shock that doesn't respond to fluids, often with hyponatremia, hyperkalemia and hypoglycemia; suspect it in anyone on long-term steroids."
      }
    ],
    "pearls": [
      "Target a mean arterial pressure of at least 65 mmHg; norepinephrine is the first-line vasopressor."
