      ]
    },
    "pathophysiology": "A fixed atherosclerotic plaque narrows a coronary artery, usually by 70% or more, so blood flow cannot rise to meet the heart's oxygen demand during exertion. The ischemia is brief and reverses with rest, without myocardial necrosis.",
    "timeline": {
      "onset": "Predictable chest pain with exertion, building over months",
      "course": "A stable pattern; pain at rest or a crescendo pattern means unstable angina"
    },
    "key_findings": {
      "history": [
        "substernal chest pressure brought on by exertion or emotion",
        "pain relieved by rest or nitroglycerin within minutes",
        "radiation to the arm, neck or jaw",
        "dyspnea on exertion"
      ],
      "exam": [
        "often normal between episodes",
        "signs of atherosclerosis such as carotid bruits or xanthelasma"
      ],
      "labs": [
        "normal troponin",
        "lipid panel and HbA1c to assess risk"
      ],
      "imaging": [
        "resting ECG often normal",
        "exercise ECG showing ST depression",
        "stress echocardiography or nuclear perfusion imaging showing ischemia",
        "coronary CT angiography showing plaque"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "stress testing: exercise ECG, stress echocardiography or myocardial perfusion imaging",
        "coronary CT angiography",
        "invasive coronary angiography when risk is high or symptoms persist"
      ],
      "criteria": [
        "Typical angina has three features: substernal discomfort, brought on by exertion or emotional stress, and relieved by rest or nitroglycerin"
      ]
    },
    "management": {
      "first_line": [
        "sublingual nitroglycerin for attacks",
        "beta blocker or calcium channel blocker for symptom control",
        "aspirin",
        "high-intensity statin",
        "risk factor control: stop smoking, treat blood pressure and diabetes"
      ],
      "next_line": [
        "long-acting nitrates or ranolazine added for persistent angina",
        "revascularization with PCI or CABG for symptoms despite medical therapy or for high-risk anatomy such as left main disease"
      ]
    },
    "complications": [
      "acute coronary syndrome",
      "heart failure",
      "arrhythmias"
    ],
    "confused_with": [
      {
        "script_id": "acute-coronary-syndrome",
        "how_to_tell_apart": "Stable angina comes on with exertion, settles with rest and leaves troponin normal; acute coronary syndrome brings pain at rest or a new crescendo pattern, and a myocardial infarction raises troponin."
      }
    ],
    "pearls": [
      "Beta blockers can worsen vasospastic (Prinzmetal) angina; calcium channel blockers treat it.",
      "Nitrates are contraindicated within 24 hours of sildenafil or 48 hours of tadalafil, because the combination causes severe hypotension.",
      "Nitrates relieve angina mainly by venodilation, which lowers preload and wall stress."
    ],
