      "ferments mannitol on mannitol salt agar"
    ],
    "transmission": [
      "colonizes the anterior nares of about 30% of people",
      "spreads by direct contact and on hands",
      "enters through broken skin, catheters and injection drug use"
    ],
    "virulence_factors": [
      "protein A, which binds the Fc region of IgG and blocks opsonization",
      "coagulase, which coats the bacteria in fibrin",
      "Panton-Valentine leukocidin, which kills white cells, in community MRSA",
      "toxic shock syndrome toxin (TSST-1), a superantigen",
      "exfoliative toxins, which cause scalded skin syndrome",
      "preformed enterotoxins, which cause food poisoning"
    ],
    "diseases": [
      "skin and soft tissue infections: abscesses, furuncles, cellulitis and impetigo",
      "acute endocarditis, often of the tricuspid valve in people who inject drugs",
      "osteomyelitis",
      "septic arthritis",
      "pneumonia, especially after influenza",
      "toxic shock syndrome",
      "staphylococcal scalded skin syndrome",
      "food poisoning with vomiting within hours"
    ],
    "diagnosis": [
      "Gram stain and culture of blood, pus or tissue",
      "catalase and coagulase tests",
      "mecA gene PCR or susceptibility testing for MRSA"
    ],
    "treatment": [
      "MSSA: nafcillin, oxacillin or cefazolin",
      "MRSA bacteremia: vancomycin or daptomycin (daptomycin not for pneumonia)",
      "MRSA pneumonia or skin infection: linezolid is also an option",
      "drain abscesses",
      "remove infected lines and devices"
    ],
    "prevention": [
      "hand hygiene",
      "nasal mupirocin decolonization before some surgeries"
    ],
