      "fluvastatin"
    ],
    "mechanism": "Inhibit HMG-CoA reductase, the rate-limiting enzyme of cholesterol synthesis in the liver. Liver cells respond by making more LDL receptors, which pull LDL out of the blood. LDL falls most; triglycerides fall a little and HDL rises a little.",
    "pharmacokinetics": [
      "simvastatin, lovastatin and atorvastatin are metabolized by CYP3A4",
      "rosuvastatin and pravastatin depend little on CYP3A4"
    ],
    "indications": [
      "established atherosclerotic cardiovascular disease",
      "LDL of 190 mg/dL or higher",
      "diabetes in adults aged 40 to 75",
      "high 10-year cardiovascular risk"
    ],
    "adverse_effects": [
      "muscle aches",
      "myopathy",
      "rhabdomyolysis, rarely",
      "raised liver enzymes",
      "a small rise in the risk of diabetes"
    ],
    "contraindications": [
      "active liver disease",
      "pregnancy and breastfeeding, for most patients"
    ],
    "interactions": [
      "CYP3A4 inhibitors such as clarithromycin, azole antifungals and grapefruit juice raise levels and the risk of myopathy",
      "gemfibrozil raises the risk of myopathy"
    ],
    "monitoring": [
      "lipid panel 4 to 12 weeks after starting",
      "liver enzymes at baseline",
      "CK only if muscle symptoms appear"
    ],
