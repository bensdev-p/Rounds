    "epidemiology": {
      "who": "Young adults, more often women",
      "risk_factors": [
        "caffeine and stimulants",
        "stress",
        "an accessory pathway (AVRT)",
        "often no trigger"
      ]
    },
    "pathophysiology": "A reentrant circuit involving the AV node causes a sudden, regular narrow-complex tachycardia. In AV nodal reentrant tachycardia (AVNRT, the most common) the circuit uses two pathways inside the AV node; in AV reentrant tachycardia (AVRT) it uses an accessory pathway.",
    "timeline": {
      "onset": "Starts and stops suddenly",
      "course": "Recurrent; cured by ablation"
    },
    "key_findings": {
      "history": [
        "palpitations that start and stop abruptly",
        "pounding in the neck",
        "dizziness",
        "passing a lot of urine after an episode"
      ],
      "exam": [
        "regular tachycardia, often 150 to 250 beats per minute"
      ],
      "labs": [
        "thyroid function tests",
        "electrolytes"
      ],
      "imaging": [
        "ECG with a regular narrow-complex tachycardia and no visible P waves, or a pseudo-R prime in V1"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "ECG during the episode"
      ],
      "criteria": []
    },
    "management": {
      "first_line": [
        "vagal maneuvers: modified Valsalva or carotid sinus massage",
        "IV adenosine if vagal maneuvers fail",
        "synchronized cardioversion if unstable"
      ],
      "next_line": [
        "IV verapamil, diltiazem or a beta blocker if adenosine fails",
        "catheter ablation for recurrent episodes"
      ]
    },
    "complications": [
      "syncope",
      "tachycardia-induced cardiomyopathy, rarely"
    ],
    "confused_with": [
      {
        "script_id": "wolff-parkinson-white-syndrome",
        "how_to_tell_apart": "AV nodal reentrant tachycardia (AVNRT) has a normal resting ECG and a circuit inside the AV node; WPW shows a delta wave and short PR at rest from an accessory pathway."
      },
      {
        "script_id": "ventricular-tachycardia",
        "how_to_tell_apart": "SVT is usually a narrow-complex tachycardia that responds to vagal maneuvers or adenosine; VT is a wide-complex tachycardia with AV dissociation, fusion and capture beats, usually with structural heart disease."
      }
    ],
    "pearls": [
      "The modified Valsalva maneuver, a strain followed by lying flat with the legs raised, converts more SVT than the standard maneuver.",
      "AVNRT is the most common type of paroxysmal SVT.",
      "Avoid carotid sinus massage in patients with a carotid bruit or a prior stroke."
    ],
    "difficulty_tiers": {
