      "who": "Women under 40, especially of East Asian descent",
      "risk_factors": [
        "female sex",
        "age under 40",
        "East Asian ancestry"
      ]
    },
    "pathophysiology": "Granulomatous inflammation of the aorta and its major branches thickens the walls and narrows the lumen, causing stenoses, occlusions and aneurysms.",
    "timeline": {
      "onset": "An early systemic phase of fever, malaise and joint pain, then a vascular phase over months to years",
      "course": "Chronic and relapsing"
    },
    "key_findings": {
      "history": [
        "fever, weight loss and fatigue",
        "arm claudication",
        "dizziness or visual changes",
        "chest pain"
      ],
      "exam": [
        "weak or absent arm pulses",
        "systolic blood pressure differing by 20 mmHg or more between the arms",
        "bruits over the subclavian arteries or aorta",
        "hypertension from renal artery stenosis"
      ],
      "labs": [
        "raised ESR or CRP"
      ],
      "imaging": [
        "CT or MR angiography showing aortic wall thickening and branch stenoses",
        "PET for active inflammation"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "CT or MR angiography"
      ],
      "criteria": []
    },
    "management": {
      "first_line": [
        "high-dose glucocorticoids",
        "a steroid-sparing drug such as methotrexate, azathioprine, mycophenolate, leflunomide or a TNF inhibitor"
      ],
      "next_line": [
        "tocilizumab",
        "revascularization for critical stenoses, preferably when inflammation is quiet"
      ]
    },
    "complications": [
      "aortic regurgitation",
      "renovascular hypertension",
      "stroke",
      "aortic aneurysm",
      "heart failure"
    ],
    "confused_with": [
