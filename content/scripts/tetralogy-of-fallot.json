    ],
    "epidemiology": {
      "who": "Infants; the most common cyanotic congenital heart disease beyond the newborn period",
      "risk_factors": [
        "22q11.2 deletion (DiGeorge syndrome)",
        "maternal diabetes",
        "trisomy 21"
      ]
    },
    "pathophysiology": "Anterosuperior displacement of the infundibular septum causes four features: pulmonary stenosis (right ventricular outflow obstruction), right ventricular hypertrophy, an overriding aorta and a ventricular septal defect. The degree of outflow obstruction decides how much blood shunts right to left, and so how cyanotic the child is.",
    "timeline": {
      "onset": "Cyanosis in infancy, sometimes within days",
      "course": "Repaired surgically in the first year; most now survive into adulthood"
    },
    "key_findings": {
      "history": [
        "cyanotic spells (tet spells) with crying or feeding",
        "squatting in older children"
      ],
      "exam": [
        "cyanosis",
        "harsh systolic ejection murmur at the left upper sternal border from the pulmonary stenosis",
        "clubbing in older children"
      ],
      "labs": [
        "polycythemia from chronic hypoxemia"
      ],
      "imaging": [
        "boot-shaped heart on chest X-ray",
        "echocardiogram showing the four features"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "echocardiogram"
      ],
      "criteria": []
    },
    "management": {
      "first_line": [
        "tet spell: knees to chest, oxygen, morphine and IV fluids",
        "complete surgical repair in the first year of life"
      ],
      "next_line": [
        "phenylephrine to raise systemic vascular resistance in a spell that does not settle",
        "propranolol to prevent spells before repair"
      ]
    },
    "complications": [
      "tet spells",
      "pulmonary regurgitation after repair",
      "arrhythmias",
      "paradoxical embolism"
    ],
    "confused_with": [
      {
        "script_id": "ventricular-septal-defect",
        "how_to_tell_apart": "Tetralogy of Fallot causes cyanosis because outflow obstruction drives blood right to left across the VSD; an isolated VSD shunts left to right, so the child stays pink unless Eisenmenger syndrome develops."
      },
      {
        "script_id": "transposition-of-the-great-arteries",
        "how_to_tell_apart": "Tetralogy of Fallot usually causes cyanosis later in infancy with a boot-shaped heart; transposition causes severe cyanosis in the first days of life with an egg-on-a-string heart."
      }
    ],
    "pearls": [
      "Squatting raises systemic vascular resistance, which pushes more blood through the lungs and relieves cyanosis.",
      "The mnemonic PROVe: pulmonary stenosis, right ventricular hypertrophy, overriding aorta, VSD.",
      "A tet spell is treated by raising systemic resistance and calming the child, never with inotropes."
    ],
