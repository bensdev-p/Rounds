    "epidemiology": {
      "who": "Newborns; the most common cyanotic heart lesion presenting in the first days of life",
      "risk_factors": [
        "maternal diabetes",
        "male sex"
      ]
    },
    "pathophysiology": "The aorta arises from the right ventricle and the pulmonary artery from the left ventricle, creating two parallel circulations. Survival depends on mixing through a patent ductus arteriosus, a patent foramen ovale or a septal defect.",
    "timeline": {
      "onset": "Severe cyanosis within hours to days of birth as the duct closes",
      "course": "Fatal within weeks untreated; excellent outcome after the arterial switch"
    },
    "key_findings": {
      "history": [
        "cyanosis soon after birth"
      ],
      "exam": [
        "profound cyanosis that does not improve with oxygen",
        "single loud S2",
        "often no murmur"
      ],
      "labs": [
        "severe hypoxemia that does not correct with 100% oxygen (a failed hyperoxia test)"
      ],
      "imaging": [
        "chest X-ray with an egg-on-a-string heart",
        "echocardiogram showing the transposed great arteries"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "echocardiogram"
      ],
      "criteria": []
    },
    "management": {
      "first_line": [
        "prostaglandin E1 to keep the ductus open",
        "balloon atrial septostomy to improve mixing if needed",
        "arterial switch operation in the first weeks of life"
      ],
      "next_line": [
        "lifelong follow-up for coronary and neoaortic problems"
      ]
    },
    "complications": [
      "death without mixing",
      "coronary problems after the switch",
      "neoaortic regurgitation"
    ],
    "confused_with": [
      {
        "script_id": "tetralogy-of-fallot",
        "how_to_tell_apart": "Transposition causes severe cyanosis in the first days of life with an egg-on-a-string heart; tetralogy of Fallot usually causes cyanosis later in infancy with a boot-shaped heart."
      }
    ],
    "pearls": [
      "Transposition is the most common cyanotic lesion presenting in the newborn period; tetralogy of Fallot is the most common cyanotic lesion overall.",
      "Infants of diabetic mothers have a higher risk of transposition.",
      "The arterial switch swaps the great arteries and reimplants the coronary arteries."
    ],
