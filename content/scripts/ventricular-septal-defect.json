    ],
    "rotation": [
      "peds"
    ],
    "epidemiology": {
      "who": "Infants and children; the most common congenital heart defect, apart from a bicuspid aortic valve",
      "risk_factors": [
        "trisomy 21",
        "trisomy 13",
        "trisomy 18",
        "fetal alcohol syndrome"
      ]
    },
    "pathophysiology": "A hole in the ventricular septum, most often membranous, lets blood shunt left to right. A large defect floods the lungs and causes heart failure; untreated, rising pulmonary resistance can reverse the shunt (Eisenmenger syndrome).",
    "timeline": {
      "onset": "The murmur appears days to weeks after birth as pulmonary resistance falls",
      "course": "Many small muscular defects close on their own; large ones need repair"
    },
    "key_findings": {
      "history": [
        "often no symptoms if small",
        "poor feeding, sweating and failure to thrive if large",
        "fast breathing"
      ],
      "exam": [
        "harsh holosystolic murmur at the left lower sternal border",
        "a louder murmur often means a smaller defect",
        "signs of heart failure in large defects"
      ],
      "labs": [],
      "imaging": [
        "echocardiogram showing the defect and the shunt",
        "chest X-ray with increased pulmonary vascular markings in large defects"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "echocardiogram"
      ],
      "criteria": []
    },
    "management": {
      "first_line": [
        "watch small defects, since many close by themselves",
        "diuretics for heart failure while waiting"
      ],
      "next_line": [
        "surgical or device closure for large defects with heart failure, failure to thrive or rising pulmonary pressure"
      ]
    },
    "complications": [
      "heart failure",
      "Eisenmenger syndrome",
      "infective endocarditis",
      "aortic regurgitation"
    ],
    "confused_with": [
      {
        "script_id": "tetralogy-of-fallot",
        "how_to_tell_apart": "An isolated VSD shunts left to right, so the child is pink with a holosystolic murmur; tetralogy of Fallot adds outflow obstruction that drives blood right to left and causes cyanosis."
      },
      {
        "script_id": "atrial-septal-defect",
        "how_to_tell_apart": "A VSD gives a harsh holosystolic murmur at the left lower sternal border in infancy; an ASD gives wide fixed splitting of S2 and a soft pulmonary flow murmur, often found in adults."
      },
      {
        "script_id": "patent-ductus-arteriosus",
        "how_to_tell_apart": "A VSD gives a holosystolic murmur at the left lower sternal border; a PDA gives a continuous machine-like murmur below the left clavicle with bounding pulses."
      }
    ],
    "pearls": [
      "Smaller defects are louder, because blood jets through a small hole at high speed.",
      "Once Eisenmenger syndrome sets in, the defect can no longer be closed.",
      "Muscular defects are the ones most likely to close on their own."
    ],
