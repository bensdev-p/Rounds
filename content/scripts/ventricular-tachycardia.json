    "rotation": [
      "IM",
      "EM"
    ],
    "epidemiology": {
      "who": "Adults with structural heart disease, most often a prior myocardial infarction",
      "risk_factors": [
        "prior myocardial infarction with scar",
        "cardiomyopathy",
        "heart failure with a low ejection fraction",
        "electrolyte disturbances such as low potassium or magnesium",
        "long QT, causing torsades de pointes",
        "drug toxicity"
      ]
    },
    "pathophysiology": "A rapid rhythm starting in the ventricles, usually from reentry around scar after an MI, at rates above 100 and usually 150 to 250, with wide QRS complexes. It can degenerate into ventricular fibrillation.",
    "timeline": {
      "onset": "Sudden",
      "course": "Sustained VT lasts over 30 seconds or needs earlier termination because of hemodynamic compromise; it can cause shock and cardiac arrest"
    },
    "key_findings": {
      "history": [
        "palpitations",
        "dizziness or syncope",
        "chest pain",
        "cardiac arrest"
      ],
      "exam": [
        "tachycardia",
        "hypotension or no pulse",
        "cannon A waves from AV dissociation"
      ],
      "labs": [
        "potassium and magnesium",
        "troponin"
      ],
      "imaging": [
        "ECG: regular wide-complex tachycardia with AV dissociation, fusion beats and capture beats",
        "echocardiogram, cardiac MRI and coronary assessment after recovery"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "12-lead ECG"
      ],
      "criteria": [
        "a wide-complex tachycardia in a patient with structural heart disease is VT until proven otherwise"
      ]
    },
    "management": {
      "first_line": [
        "pulseless VT: defibrillation and advanced life support",
        "unstable VT with a pulse: synchronized cardioversion",
        "stable VT: synchronized cardioversion, or IV procainamide, amiodarone or sotalol"
      ],
      "next_line": [
        "ICD for secondary prevention",
        "catheter ablation for recurrent VT",
        "IV magnesium for torsades de pointes"
      ]
    },
    "complications": [
      "ventricular fibrillation",
      "cardiac arrest",
      "sudden death"
    ],
    "confused_with": [
      {
        "script_id": "supraventricular-tachycardia",
        "how_to_tell_apart": "VT is a wide-complex tachycardia with AV dissociation, fusion and capture beats, usually with structural heart disease; SVT is usually narrow-complex and responds to vagal maneuvers or adenosine."
      },
      {
        "script_id": "long-qt-syndrome",
        "how_to_tell_apart": "Scar-related VT is usually monomorphic, with structural heart disease; long QT syndrome causes polymorphic VT (torsades de pointes) with a long QT between episodes, treated with magnesium."
      }
    ],
    "pearls": [
      "Treat any wide-complex tachycardia as VT if in doubt, especially after an MI.",
      "Fusion and capture beats prove AV dissociation and make the diagnosis VT.",
      "Torsades de pointes is polymorphic VT with a long QT; give IV magnesium."
    ],
