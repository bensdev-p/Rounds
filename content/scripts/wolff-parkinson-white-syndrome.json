    "epidemiology": {
      "who": "Children and young adults; the pattern is found in about 1 to 3 per 1000 people",
      "risk_factors": [
        "Ebstein anomaly",
        "hypertrophic cardiomyopathy",
        "family history"
      ]
    },
    "pathophysiology": "An accessory pathway (bundle of Kent) connects the atria and ventricles, bypassing the AV node. The ventricles are pre-excited, and the pathway can carry reentrant tachycardias or conduct atrial fibrillation very fast to the ventricles.",
    "timeline": {
      "onset": "Palpitations often begin in childhood or adolescence",
      "course": "Many have no symptoms; a small risk of sudden death from pre-excited atrial fibrillation"
    },
    "key_findings": {
      "history": [
        "episodes of palpitations",
        "dizziness or syncope",
        "sudden death, rarely, as the first sign"
      ],
      "exam": [
        "often normal between episodes"
      ],
      "labs": [],
      "imaging": [
        "ECG with a short PR interval, a delta wave and a wide QRS",
        "echocardiogram to look for structural disease such as Ebstein anomaly"
      ]
    },
    "diagnosis": {
      "confirmatory_tests": [
        "ECG",
        "electrophysiology study"
      ],
      "criteria": [
        "WPW syndrome: pre-excitation on the ECG plus a tachyarrhythmia"
      ]
    },
    "management": {
      "first_line": [
        "catheter ablation of the accessory pathway for patients with symptoms",
        "vagal maneuvers or adenosine for orthodromic reentrant tachycardia with a narrow QRS"
      ],
      "next_line": [
        "procainamide, ibutilide or electrical cardioversion for pre-excited atrial fibrillation",
        "avoid AV nodal blockers (adenosine, beta blockers, verapamil, diltiazem, digoxin) and IV amiodarone in pre-excited atrial fibrillation"
      ]
    },
    "complications": [
      "atrioventricular reentrant tachycardia",
      "pre-excited atrial fibrillation turning into ventricular fibrillation",
      "sudden cardiac death"
    ],
    "confused_with": [
      {
        "script_id": "supraventricular-tachycardia",
        "how_to_tell_apart": "WPW shows a delta wave and short PR at rest from an accessory pathway; AV nodal reentrant tachycardia has a normal resting ECG and a circuit inside the AV node."
      }
    ],
    "pearls": [
      "Pre-excited atrial fibrillation looks like an irregular, very fast, wide-complex tachycardia with changing QRS shapes.",
      "Ablation cures most patients.",
      "Ebstein anomaly is often associated with accessory pathways."
    ],
