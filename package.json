{
  "name": "rounds",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=mobile",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "supabase": "supabase",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/db/database.types.ts && prettier --write packages/shared/src/db/database.types.ts",
    "content:seed": "pnpm --filter @rounds/shared content:seed",
    "test:integration": "pnpm --filter @rounds/shared test:integration"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "supabase": "^3.1.0",
    "turbo": "^2.11.11"
  }
}
