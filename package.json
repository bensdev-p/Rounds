{
  "name": "rounds",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=mobile",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && pnpm functions:check",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "supabase": "supabase",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/db/database.types.ts && prettier --write packages/shared/src/db/database.types.ts",
    "functions:serve": "supabase functions serve",
    "functions:serve:fake": "supabase functions serve --env-file supabase/functions/.env.test",
    "functions:check": "deno check --config supabase/functions/grade-answer/deno.json supabase/functions/grade-answer/index.ts supabase/functions/grade-answer/eval/run.ts",
    "content:seed": "pnpm --filter @rounds/shared content:seed",
    "test:integration": "pnpm --filter @rounds/shared test:integration",
    "content:check": "pnpm --filter @rounds/shared content:check",
    "content:review": "pnpm --filter @rounds/shared content:review",
    "content:approve": "pnpm --filter @rounds/shared content:approve",
    "eval:grading": "deno run --config supabase/functions/grade-answer/deno.json --allow-read --allow-env --allow-net=api.anthropic.com --allow-write=supabase/functions/grade-answer/eval/results supabase/functions/grade-answer/eval/run.ts",
    "phone": "node scripts/phone.mjs"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "supabase": "^3.1.0",
    "turbo": "^2.11.11"
  },
  "devEngines": {
    "runtime": {
      "name": "deno",
      "version": "2.9.6",
      "onFail": "download"
    }
  }
}
