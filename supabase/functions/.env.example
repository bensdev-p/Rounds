# Copy to supabase/functions/.env (gitignored) and fill in. Never commit the key.
ANTHROPIC_API_KEY=
# anthropic (default) | fake | none
LLM_PROVIDER=anthropic
# Model used for grading.
GRADER_MODEL=claude-opus-5-5
# Voice (M2.5): Deepgram for speech-to-text (Nova-3) and the attending's voice (Aura-2).
# Needs the Member role so the server can grant the app short-lived streaming tokens.
# Without it, voice is off and sessions open in text mode.
DEEPGRAM_API_KEY=
# deepgram (default) | fake
SPEECH_PROVIDER=deepgram
